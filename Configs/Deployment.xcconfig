CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM = 67CQ77V27R
ARCHS = arm64
MACOSX_DEPLOYMENT_TARGET = 27.0

// yina uses one version number for both CFBundleVersion and
// CFBundleShortVersionString. Sparkle compares CFBundleVersion, so it must rise
// for every release or no update is offered. Local builds pass a date-based
// YINA_VERSION so debugging never dirties the tree; releases pass the contents
// of the VERSION file at the repository root. See AGENTS.md for the bump rule.
YINA_VERSION = 1.0
CURRENT_PROJECT_VERSION = $(YINA_VERSION)
MARKETING_VERSION = $(YINA_VERSION)
ONLY_ACTIVE_ARCH = NO
