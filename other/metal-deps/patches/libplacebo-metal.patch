+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+#include "metal_ops.h"
+
+static void metal_gpu_destroy(pl_gpu gpu);
+
+static const struct pl_gpu_fns pl_fns_metal = {
+    .destroy         = metal_gpu_destroy,
+
+    .tex_create      = pl_metal_tex_create,
+    .tex_destroy     = pl_metal_tex_destroy,
+    .tex_invalidate  = pl_metal_tex_invalidate,
+    .tex_clear_ex    = pl_metal_tex_clear_ex,
+    .tex_blit        = pl_metal_tex_blit,
+    .tex_upload      = pl_metal_tex_upload,
+    .tex_download    = pl_metal_tex_download,
+    .tex_poll        = pl_metal_tex_poll,
+
+    .buf_create      = pl_metal_buf_create,
+    .buf_destroy     = pl_metal_buf_destroy,
+    .buf_write       = pl_metal_buf_write,
+    .buf_read        = pl_metal_buf_read,
+    .buf_copy        = pl_metal_buf_copy,
+
+    .desc_namespace  = pl_metal_desc_namespace,
+    .pass_create     = pl_metal_pass_create,
+    .pass_destroy    = pl_metal_pass_destroy,
+    .pass_run        = pl_metal_pass_run,
+
+    .timer_create    = pl_metal_timer_create,
+    .timer_destroy   = pl_metal_timer_destroy,
+    .timer_query     = pl_metal_timer_query,
+
+    .gpu_flush       = pl_metal_gpu_flush,
+    .gpu_finish      = pl_metal_gpu_finish,
+    .gpu_is_failed   = pl_metal_gpu_is_failed,
+};
+
+static void metal_gpu_destroy(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    metal_cmd_submit(p, true);
+
+    pl_spirv_destroy(&p->spirv);
+
+    for (int sm = 0; sm < PL_TEX_SAMPLE_MODE_COUNT; sm++) {
+        for (int am = 0; am < PL_TEX_ADDRESS_MODE_COUNT; am++) {
+            if (p->samplers[sm][am])
+                CFBridgingRelease(p->samplers[sm][am]);
+        }
+    }
+
+    for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+        if (p->vtx_bufs[i])
+            CFBridgingRelease(p->vtx_bufs[i]);
+        if (p->idx_bufs[i])
+            CFBridgingRelease(p->idx_bufs[i]);
+    }
+
+    if (p->timestamp_counter_set)
+        CFBridgingRelease(p->timestamp_counter_set);
+
+    pl_free((void *) gpu);
+}
+
+pl_gpu pl_gpu_create_metal(struct pl_metal_ctx *ctx,
+                           const struct pl_metal_params *params)
+{
+    if (!(@available(macOS 10.15, *))) {
+        pl_err(ctx->log, "Metal backend requires macOS 10.15 or later");
+        return NULL;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>) ctx->metal->device;
+    pl_assert(device);
+
+    struct pl_gpu_t *gpu = pl_zalloc_obj(NULL, gpu, struct pl_gpu_metal);
+    gpu->log = ctx->log;
+
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    *p = (struct pl_gpu_metal) {
+        .impl = pl_fns_metal,
+        .ctx  = ctx,
+    };
+
+    gpu->glsl = (struct pl_glsl_version) {
+        .version = 450,
+        .vulkan  = true,
+    };
+
+    if (!params->no_compute) {
+        // All Metal 2+ hardware supports compute. Query actual limits.
+        // MTLDevice only exposes per-axis limits; the per-axis width limit equals
+        // the total-threads cap on all known macOS Metal devices (1024 on Apple
+        // Silicon and Intel, 512 on very old hardware). Use it as the total cap.
+        gpu->glsl.compute           = true;
+        gpu->glsl.max_group_threads = (uint32_t) device.maxThreadsPerThreadgroup.width;
+        gpu->glsl.max_group_size[0] = (uint32_t) device.maxThreadsPerThreadgroup.width;
+        gpu->glsl.max_group_size[1] = (uint32_t) device.maxThreadsPerThreadgroup.height;
+        gpu->glsl.max_group_size[2] = (uint32_t) device.maxThreadsPerThreadgroup.depth;
+
+        gpu->glsl.max_shmem_size = (uint32_t) device.maxThreadgroupMemoryLength;
+    }
+
+    // Texture-gather offsets supported by MSL
+    gpu->glsl.min_gather_offset = -8;
+    gpu->glsl.max_gather_offset = 7;
+
+    size_t max_buf = (size_t) device.maxBufferLength;
+
+    gpu->limits = (struct pl_gpu_limits) {
+        .max_buf_size  = max_buf,
+        .max_ssbo_size = max_buf,
+        .max_vbo_size  = max_buf,
+        // Metal has no UBO concept; buffer bindings are used instead.
+        .max_ubo_size  = max_buf,
+
+        // Minimum guaranteed by Metal 2; real limits vary by GPU.
+        .max_tex_1d_dim = 16384,
+        .max_tex_2d_dim = 16384,
+        .max_tex_3d_dim = 2048,
+
+        .buf_transfer = true,
+
+        // Row-pitch must be a multiple of 256 bytes on Metal.
+        .align_tex_xfer_pitch = 256,
+        .align_tex_xfer_offset = 256,
+
+        .align_vertex_stride = 4,
+        .max_dispatch = { UINT32_MAX, UINT32_MAX, UINT32_MAX },
+        .max_pushc_size   = 4096,
+        .max_variable_comps = 0,  // use UBOs instead
+
+        .fragment_queues = 1,
+        .compute_queues  = params->no_compute ? 0 : 1,
+
+        // Metal command buffers are not thread-safe by default.
+        .thread_safe = false,
+
+        .blittable_1d_3d = true,
+    };
+
+    p->spirv = pl_spirv_create(ctx->log, (struct pl_spirv_version) {
+        .env_version = pl_spirv_version_to_vulkan(PL_MAX_SPIRV_VER),
+        .spv_version = PL_MAX_SPIRV_VER,
+    });
+    if (!p->spirv) {
+        PL_ERR(gpu, "Failed to create SPIR-V compiler");
+        goto error;
+    }
+
+    static const MTLSamplerMinMagFilter sample_filters[PL_TEX_SAMPLE_MODE_COUNT] = {
+        [PL_TEX_SAMPLE_NEAREST] = MTLSamplerMinMagFilterNearest,
+        [PL_TEX_SAMPLE_LINEAR]  = MTLSamplerMinMagFilterLinear,
+    };
+    static const MTLSamplerAddressMode address_modes[PL_TEX_ADDRESS_MODE_COUNT] = {
+        [PL_TEX_ADDRESS_CLAMP]        = MTLSamplerAddressModeClampToEdge,
+        [PL_TEX_ADDRESS_REPEAT]       = MTLSamplerAddressModeRepeat,
+        [PL_TEX_ADDRESS_MIRROR] = MTLSamplerAddressModeMirrorRepeat,
+    };
+    for (int sm = 0; sm < PL_TEX_SAMPLE_MODE_COUNT; sm++) {
+        for (int am = 0; am < PL_TEX_ADDRESS_MODE_COUNT; am++) {
+            MTLSamplerDescriptor *desc = [MTLSamplerDescriptor new];
+            desc.minFilter  = sample_filters[sm];
+            desc.magFilter  = sample_filters[sm];
+            desc.mipFilter  = MTLSamplerMipFilterNotMipmapped;
+            desc.sAddressMode = address_modes[am];
+            desc.tAddressMode = address_modes[am];
+            desc.rAddressMode = address_modes[am];
+            p->samplers[sm][am] = (void *) CFBridgingRetain(
+                [device newSamplerStateWithDescriptor:desc]);
+        }
+    }
+
+    if (@available(macOS 11.0, *)) {
+        if ([device supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary]) {
+            for (id<MTLCounterSet> cs in device.counterSets) {
+                for (id<MTLCounter> counter in cs.counters) {
+                    if ([counter.name isEqualToString:MTLCommonCounterTimestamp]) {
+                        p->timestamp_counter_set = (void *) CFBridgingRetain(cs);
+                        p->has_gpu_timer = true;
+                        break;
+                    }
+                }
+                if (p->has_gpu_timer) break;
+            }
+        }
+    }
+    // sampleCountersInBuffer:atSampleIndex:withBarrier: asserts on AGX (Apple
+    // Silicon) even when supportsCounterSampling:atStageBoundary returns YES.
+    // Suppress timer support on all Apple-family GPUs to avoid the crash.
+    if (@available(macOS 10.15, *)) {
+        if (p->has_gpu_timer && [device supportsFamily:MTLGPUFamilyApple1]) {
+            if (p->timestamp_counter_set) {
+                CFBridgingRelease(p->timestamp_counter_set);
+                p->timestamp_counter_set = NULL;
+            }
+            p->has_gpu_timer = false;
+        }
+    }
+    PL_DEBUG(gpu, "GPU timestamp counters: %s",
+             p->has_gpu_timer ? "available" : "unavailable on this device/OS");
+
+    pl_metal_setup_formats(gpu);
+
+    return pl_gpu_finalize(gpu);
+
+error:
+    metal_gpu_destroy(gpu);
+    return NULL;
+}
+
+pl_timer pl_metal_timer_create(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    if (!p->has_gpu_timer)
+        return NULL;
+
+    if (@available(macOS 11.0, *)) {
+        id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+        id<MTLCounterSet> cs = (__bridge id<MTLCounterSet>) p->timestamp_counter_set;
+
+        MTLCounterSampleBufferDescriptor *desc = [MTLCounterSampleBufferDescriptor new];
+        desc.counterSet  = cs;
+        desc.storageMode = MTLStorageModeShared;
+        desc.sampleCount = METAL_TIMER_SLOTS * 2; // start + end per slot
+
+        NSError *err = nil;
+        id<MTLCounterSampleBuffer> sbuf =
+            [device newCounterSampleBufferWithDescriptor:desc error:&err];
+        if (!sbuf) {
+            PL_WARN(gpu, "Failed to create MTLCounterSampleBuffer: %s",
+                    err.localizedDescription.UTF8String);
+            return NULL;
+        }
+
+        struct pl_timer_t *timer = pl_alloc_ptr(NULL, timer);
+        *timer = (struct pl_timer_t) {
+            .sample_buf = (void *) CFBridgingRetain(sbuf),
+        };
+        return timer;
+    }
+
+    return NULL;
+}
+
+void pl_metal_timer_destroy(pl_gpu gpu, pl_timer timer)
+{
+    (void) gpu;
+    if (timer->sample_buf)
+        CFBridgingRelease(timer->sample_buf);
+    pl_free(timer);
+}
+
+uint64_t pl_metal_timer_query(pl_gpu gpu, pl_timer timer)
+{
+    (void) gpu;
+
+    if (@available(macOS 11.0, *)) {
+        for (; timer->pending > 0; timer->pending--) {
+            int index = timer->current - timer->pending;
+            if (index < 0) index += METAL_TIMER_SLOTS;
+
+            id<MTLCounterSampleBuffer> sbuf =
+                (__bridge id<MTLCounterSampleBuffer>) timer->sample_buf;
+            NSData *data = [sbuf resolveCounterRange:NSMakeRange((NSUInteger)(index * 2), 2)];
+            if (!data || data.length < 2 * sizeof(MTLCounterResultTimestamp))
+                return 0; // GPU hasn't written this slot yet, back off
+
+            const MTLCounterResultTimestamp *ts = data.bytes;
+            if (ts[0].timestamp == MTLCounterErrorValue ||
+                ts[1].timestamp == MTLCounterErrorValue)
+                continue;
+
+            // We got a result. Consume it and return nanoseconds.
+            timer->pending--;
+            uint64_t ns = ts[1].timestamp - ts[0].timestamp;
+            return PL_MAX(ns, 1);
+        }
+    }
+
+    return 0;
+}
+
+void pl_metal_timer_start(pl_timer timer, void *enc_opaque)
+{
+    if (!timer || !timer->sample_buf || !enc_opaque) return;
+
+    if (@available(macOS 11.0, *)) {
+        // Cast to untyped `id`, the actual object (MTLComputeCommandEncoder or
+        // MTLRenderCommandEncoder) responds to this selector at runtime even though
+        // the base MTLCommandEncoder protocol does not declare it.
+        id enc = (__bridge id) enc_opaque;
+        id<MTLCounterSampleBuffer> sbuf =
+            (__bridge id<MTLCounterSampleBuffer>) timer->sample_buf;
+        [enc sampleCountersInBuffer:sbuf
+                     atSampleIndex:(NSUInteger)(timer->current * 2)
+                       withBarrier:NO];
+    }
+}
+
+// Must be called exactly once per pl_metal_timer_start; advances the ring slot.
+void pl_metal_timer_end(pl_timer timer, void *enc_opaque)
+{
+    if (!timer || !timer->sample_buf || !enc_opaque) return;
+
+    if (@available(macOS 11.0, *)) {
+        id enc = (__bridge id) enc_opaque;
+        id<MTLCounterSampleBuffer> sbuf =
+            (__bridge id<MTLCounterSampleBuffer>) timer->sample_buf;
+        [enc sampleCountersInBuffer:sbuf
+                     atSampleIndex:(NSUInteger)(timer->current * 2 + 1)
+                       withBarrier:YES]; // barrier ensures preceding work is timestamped
+    }
+
+    timer->current = (timer->current + 1) % METAL_TIMER_SLOTS;
+    if (timer->pending < METAL_TIMER_SLOTS)
+        timer->pending++;
+}
+
+void pl_metal_gpu_flush(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    metal_cmd_submit(p, false);
+}
+
+void pl_metal_gpu_finish(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    metal_cmd_submit(p, true);
+}
+
+bool pl_metal_gpu_is_failed(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    return p->ctx->failed;
+}
+
+pl_metal pl_metal_get(pl_gpu gpu)
+{
+    const struct pl_gpu_fns *impl = PL_PRIV(gpu);
+    if (impl->destroy == metal_gpu_destroy) {
+        struct pl_gpu_metal *p = (struct pl_gpu_metal *) impl;
+        return p->ctx->metal;
+    }
+    return NULL;
+}
diff --git a/src/metal/gpu_buf.m b/src/metal/gpu_buf.m
new file mode 100644
index 0000000..27b9b15
--- /dev/null
+++ b/src/metal/gpu_buf.m
@@ -0,0 +1,183 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
