+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+#include "metal_ops.h"
+
+pl_buf pl_metal_buf_create(pl_gpu gpu, const struct pl_buf_params *params)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+
+    struct pl_buf_t *buf = pl_zalloc_obj(NULL, buf, struct pl_buf_metal);
+    buf->params = *params;
+    buf->params.initial_data = NULL;
+
+    struct pl_buf_metal *buf_p = PL_PRIV(buf);
+
+    bool host_accessible = params->host_readable || params->host_writable;
+    MTLResourceOptions options = host_accessible
+        ? MTLResourceStorageModeShared
+        : MTLResourceStorageModePrivate;
+
+    buf_p->host_visible = host_accessible;
+
+    id<MTLBuffer> mtl_buf = [device newBufferWithLength:params->size options:options];
+    if (!mtl_buf) {
+        PL_ERR(gpu, "Failed to allocate MTLBuffer of size %zu", params->size);
+        goto error;
+    }
+
+    buf_p->buf = (void *) CFBridgingRetain(mtl_buf);
+
+    if (params->initial_data) {
+        if (host_accessible) {
+            memcpy(mtl_buf.contents, params->initial_data, params->size);
+        } else {
+            id<MTLBuffer> staging = [device newBufferWithBytes:params->initial_data
+                                                        length:params->size
+                                                       options:MTLResourceStorageModeShared];
+            if (!staging) {
+                PL_ERR(gpu, "Failed to allocate staging buffer for initial_data");
+                goto error;
+            }
+
+            id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+            [blit copyFromBuffer:staging
+                    sourceOffset:0
+                        toBuffer:mtl_buf
+               destinationOffset:0
+                            size:params->size];
+            // Non-blocking: staging released via completion handler once GPU is done.
+            metal_cmd_submit_with_staging(p, staging);
+        }
+    }
+
+    return buf;
+
+error:
+    pl_metal_buf_destroy(gpu, buf);
+    return NULL;
+}
+
+void pl_metal_buf_destroy(pl_gpu gpu, pl_buf buf)
+{
+    struct pl_buf_metal *buf_p = PL_PRIV(buf);
+    (void) gpu;
+
+    if (buf_p->buf)
+        CFBridgingRelease(buf_p->buf);
+
+    pl_free((void *) buf);
+}
+
+void pl_metal_buf_write(pl_gpu gpu, pl_buf buf, size_t offset,
+                        const void *data, size_t size)
+{
+    struct pl_buf_metal *buf_p = PL_PRIV(buf);
+    id<MTLBuffer> mtl_buf = (__bridge id<MTLBuffer>) buf_p->buf;
+
+    if (buf_p->host_visible) {
+        // MTLStorageModeShared is always CPU-coherent on macOS.
+        memcpy((char *) mtl_buf.contents + offset, data, size);
+        return;
+    }
+
+    // newBufferWithBytes:length:options: copies `data` immediately, so the
+    // caller's pointer is safe to reuse on return. The staging buffer is
+    // released asynchronously once the GPU blit completes.
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+
+    id<MTLBuffer> staging = [device newBufferWithBytes:data
+                                               length:size
+                                              options:MTLResourceStorageModeShared];
+    if (!staging) {
+        PL_ERR(gpu, "Failed to allocate staging buffer for buf_write");
+        return;
+    }
+
+    id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+    [blit copyFromBuffer:staging
+            sourceOffset:0
+                toBuffer:mtl_buf
+       destinationOffset:offset
+                    size:size];
+    metal_cmd_submit_with_staging(p, staging);
+}
+
+bool pl_metal_buf_read(pl_gpu gpu, pl_buf buf, size_t offset,
+                       void *dest, size_t size)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    struct pl_buf_metal *buf_p = PL_PRIV(buf);
+    id<MTLBuffer> mtl_buf = (__bridge id<MTLBuffer>) buf_p->buf;
+
+    if (buf_p->host_visible) {
+        // Flush any pending command buffer so GPU blits into this shared buffer
+        // (e.g. from pl_buf_copy with a private source) are visible to the CPU.
+        metal_cmd_submit(p, true);
+        memcpy(dest, (const char *) mtl_buf.contents + offset, size);
+        return true;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+
+    id<MTLBuffer> staging = [device newBufferWithLength:size
+                                               options:MTLResourceStorageModeShared];
+    if (!staging) {
+        PL_ERR(gpu, "Failed to allocate staging buffer for buf_read");
+        return false;
+    }
+
+    id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+    [blit copyFromBuffer:mtl_buf
+            sourceOffset:offset
+                toBuffer:staging
+       destinationOffset:0
+                    size:size];
+    metal_cmd_submit(p, true);
+
+    memcpy(dest, staging.contents, size);
+    return true;
+}
+
+void pl_metal_buf_copy(pl_gpu gpu, pl_buf dst, size_t dst_offset,
+                       pl_buf src, size_t src_offset, size_t size)
+{
+    struct pl_gpu_metal *p     = PL_PRIV(gpu);
+    struct pl_buf_metal *src_p = PL_PRIV(src);
+    struct pl_buf_metal *dst_p = PL_PRIV(dst);
+
+    id<MTLBuffer> mtl_src = (__bridge id<MTLBuffer>) src_p->buf;
+    id<MTLBuffer> mtl_dst = (__bridge id<MTLBuffer>) dst_p->buf;
+
+    // Optimize host->host copies (both Shared) via memcpy to avoid GPU sync.
+    if (src_p->host_visible && dst_p->host_visible) {
+        memcpy((char *) mtl_dst.contents + dst_offset,
+               (const char *) mtl_src.contents + src_offset, size);
+        return;
+    }
+
+    id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+    [blit copyFromBuffer:mtl_src
+            sourceOffset:src_offset
+                toBuffer:mtl_dst
+       destinationOffset:dst_offset
+                    size:size];
+    // Leave the command buffer open; it will be committed at gpu_flush/finish.
+}
diff --git a/src/metal/gpu_pass.m b/src/metal/gpu_pass.m
new file mode 100644
index 0000000..1486dec
--- /dev/null
+++ b/src/metal/gpu_pass.m
@@ -0,0 +1,918 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+#include "metal_ops.h"
+#include "../cache.h"
+
+#include <spirv_cross_c.h>
+
+#define SC(cmd)                                                             \
+    do {                                                                    \
+        spvc_result res = (cmd);                                            \
+        if (res != SPVC_SUCCESS) {                                          \
+            PL_ERR(gpu, "%s: %s (%d) (%s:%d)",                              \
+                   #cmd, sc ? spvc_context_get_last_error_string(sc) : "",  \
+                   res, __FILE__, __LINE__);                                \
+            goto error;                                                     \
+        }                                                                   \
+    } while (0)
+
+static const char *stage_name(enum glsl_shader_stage s)
+{
+    switch (s) {
+    case GLSL_SHADER_VERTEX:   return "vertex";
+    case GLSL_SHADER_FRAGMENT: return "fragment";
+    case GLSL_SHADER_COMPUTE:  return "compute";
+    default:                   return "?";
+    }
+}
+
+static SpvExecutionModel stage_to_spv(enum glsl_shader_stage s)
+{
+    switch (s) {
+    case GLSL_SHADER_VERTEX:   return SpvExecutionModelVertex;
+    case GLSL_SHADER_FRAGMENT: return SpvExecutionModelFragment;
+    case GLSL_SHADER_COMPUTE:  return SpvExecutionModelGLCompute;
+    default: pl_unreachable();
+    }
+}
+
+static const char *compile_glsl_to_msl(pl_gpu gpu, pl_pass pass,
+                                        enum glsl_shader_stage stage,
+                                        const char *glsl,
+                                        bool has_pushc,
+                                        uint32_t out_local_size[3])
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    spvc_context sc = NULL;
+    const char *result = NULL;
+
+    // GLSL -> SPIR-V
+    pl_clock_t t0 = pl_clock_now();
+    pl_str spirv = pl_spirv_compile_glsl(p->spirv, (void *) pass, gpu->glsl, stage, glsl);
+    if (!spirv.len) {
+        PL_ERR(gpu, "GLSL->SPIR-V failed for %s shader", stage_name(stage));
+        return NULL;
+    }
+    pl_clock_t t1 = pl_clock_now();
+    pl_log_cpu_time(gpu->log, t0, t1, "translating GLSL to SPIR-V");
+
+    // SPIR-V -> MSL
+    spvc_parsed_ir sc_ir = NULL;
+    spvc_compiler sc_comp = NULL;
+    spvc_compiler_options sc_opts = NULL;
+    const char *msl_src = NULL;
+
+    SC(spvc_context_create(&sc));
+
+    SC(spvc_context_parse_spirv(sc, (const SpvId *) spirv.buf,
+                                spirv.len / sizeof(SpvId), &sc_ir));
+
+    SC(spvc_context_create_compiler(sc, SPVC_BACKEND_MSL, sc_ir,
+                                    SPVC_CAPTURE_MODE_TAKE_OWNERSHIP, &sc_comp));
+
+    SC(spvc_compiler_create_compiler_options(sc_comp, &sc_opts));
+
+    // MSL 2.1 is required for read-write storage images and compute atomics,
+    // it corresponds to macOS 10.14, and our min requirement is macOS 10.15.
+    SC(spvc_compiler_options_set_uint(sc_opts, SPVC_COMPILER_OPTION_MSL_VERSION,
+                                      SPVC_MAKE_MSL_VERSION(2, 1, 0)));
+
+    SC(spvc_compiler_options_set_uint(sc_opts, SPVC_COMPILER_OPTION_MSL_PLATFORM,
+                                      SPVC_MSL_PLATFORM_MACOS));
+
+    // Map SPIR-V binding numbers directly to Metal buffer/texture/sampler indices.
+    SC(spvc_compiler_options_set_bool(sc_opts,
+        SPVC_COMPILER_OPTION_MSL_ENABLE_DECORATION_BINDING, SPVC_TRUE));
+
+    if (stage == GLSL_SHADER_VERTEX) {
+        SC(spvc_compiler_options_set_bool(sc_opts,
+            SPVC_COMPILER_OPTION_FLIP_VERTEX_Y, SPVC_TRUE));
+    }
+
+    SC(spvc_compiler_install_compiler_options(sc_comp, sc_opts));
+
+    // Remap push constants to a fixed buffer slot above all normal descriptors,
+    // preventing binding slot conflicts.
+    if (has_pushc) {
+        spvc_msl_resource_binding_2 pb;
+        spvc_msl_resource_binding_init_2(&pb);
+        pb.stage      = stage_to_spv(stage);
+        pb.desc_set   = SPVC_MSL_PUSH_CONSTANT_DESC_SET;
+        pb.binding    = SPVC_MSL_PUSH_CONSTANT_BINDING;
+        pb.msl_buffer = METAL_PUSH_CONST_BUF_IDX;
+        SC(spvc_compiler_msl_add_resource_binding_2(sc_comp, &pb));
+    }
+
+    // Buffer slot 0 is occupied by the vertex data buffer, so we remap other
+    // UBO/SSBO descriptors up by 1 to avoid conflicts.
+    if (stage == GLSL_SHADER_VERTEX) {
+        for (int i = 0; i < pass->params.num_descriptors; i++) {
+            const struct pl_desc *desc = &pass->params.descriptors[i];
+            if (desc->type != PL_DESC_BUF_UNIFORM &&
+                desc->type != PL_DESC_BUF_STORAGE)
+                continue;
+            spvc_msl_resource_binding_2 rb;
+            spvc_msl_resource_binding_init_2(&rb);
+            rb.stage      = SpvExecutionModelVertex;
+            rb.desc_set   = 0;
+            rb.binding    = desc->binding;
+            rb.msl_buffer = desc->binding + 1;
+            SC(spvc_compiler_msl_add_resource_binding_2(sc_comp, &rb));
+        }
+    }
+
+    if (stage == GLSL_SHADER_COMPUTE && out_local_size) {
+        out_local_size[0] = spvc_compiler_get_execution_mode_argument_by_index(
+            sc_comp, SpvExecutionModeLocalSize, 0);
+        out_local_size[1] = spvc_compiler_get_execution_mode_argument_by_index(
+            sc_comp, SpvExecutionModeLocalSize, 1);
+        out_local_size[2] = spvc_compiler_get_execution_mode_argument_by_index(
+            sc_comp, SpvExecutionModeLocalSize, 2);
+        // Default to 1 if not declared (prevents divide-by-zero).
+        for (int i = 0; i < 3; i++) {
+            if (!out_local_size[i])
+                out_local_size[i] = 1;
+        }
+    }
+
+    SC(spvc_compiler_compile(sc_comp, &msl_src));
+    pl_log_cpu_time(gpu->log, t1, pl_clock_now(), "translating SPIR-V to MSL");
+
+    int level = PL_LOG_DEBUG;
+    PL_MSG(gpu, level, "%s shader MSL source:", stage_name(stage));
+    pl_msg_source(gpu->log, level, msl_src);
+
+    result = pl_strdup0((void *) pass, pl_str0(msl_src));
+
+error:
+    if (sc)
+        spvc_context_destroy(sc);
+    return result;
+}
+
+static MTLVertexFormat pl_fmt_to_mtl_vertex(pl_fmt fmt)
+{
+    int n = fmt->num_components;
+    int b = fmt->component_depth[0];
+
+    switch (fmt->type) {
+    case PL_FMT_FLOAT:
+        if (b == 16) { // float16
+            if (n == 2) return MTLVertexFormatHalf2;
+            if (n == 4) return MTLVertexFormatHalf4;
+        } else { // float32
+            if (n == 1) return MTLVertexFormatFloat;
+            if (n == 2) return MTLVertexFormatFloat2;
+            if (n == 3) return MTLVertexFormatFloat3;
+            if (n == 4) return MTLVertexFormatFloat4;
+        }
+        break;
+    case PL_FMT_UNORM:
+        if (b == 8) {
+            if (n == 2) return MTLVertexFormatUChar2Normalized;
+            if (n == 4) return MTLVertexFormatUChar4Normalized;
+        } else { // 16-bit
+            if (n == 2) return MTLVertexFormatUShort2Normalized;
+            if (n == 4) return MTLVertexFormatUShort4Normalized;
+        }
+        break;
+    case PL_FMT_SNORM:
+        if (b == 8) {
+            if (n == 2) return MTLVertexFormatChar2Normalized;
+            if (n == 4) return MTLVertexFormatChar4Normalized;
+        } else {
+            if (n == 2) return MTLVertexFormatShort2Normalized;
+            if (n == 4) return MTLVertexFormatShort4Normalized;
+        }
+        break;
+    case PL_FMT_UINT:
+        if (b == 16) {
+            if (n == 2) return MTLVertexFormatUShort2;
+            if (n == 4) return MTLVertexFormatUShort4;
+        } else { // 32-bit
+            if (n == 1) return MTLVertexFormatUInt;
+            if (n == 2) return MTLVertexFormatUInt2;
+            if (n == 4) return MTLVertexFormatUInt4;
+        }
+        break;
+    case PL_FMT_SINT:
+        if (b == 16) {
+            if (n == 2) return MTLVertexFormatShort2;
+            if (n == 4) return MTLVertexFormatShort4;
+        } else {
+            if (n == 1) return MTLVertexFormatInt;
+            if (n == 2) return MTLVertexFormatInt2;
+            if (n == 4) return MTLVertexFormatInt4;
+        }
+        break;
+    default:
+        break;
+    }
+    return MTLVertexFormatInvalid;
+}
+
+static MTLBlendFactor blend_factor(enum pl_blend_mode m)
+{
+    switch (m) {
+    case PL_BLEND_ZERO:               return MTLBlendFactorZero;
+    case PL_BLEND_ONE:                return MTLBlendFactorOne;
+    case PL_BLEND_SRC_ALPHA:          return MTLBlendFactorSourceAlpha;
+    case PL_BLEND_ONE_MINUS_SRC_ALPHA:return MTLBlendFactorOneMinusSourceAlpha;
+    default: pl_unreachable();
+    }
+}
+
+static id<MTLLibrary> make_library(pl_gpu gpu, id<MTLDevice> device,
+                                   const char *msl, const char *label)
+{
+    NSError *err = nil;
+    MTLCompileOptions *opts = [MTLCompileOptions new];
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    opts.fastMathEnabled = YES; // deprecated in macOS 15 in favour of mathMode
+#pragma clang diagnostic pop
+
+    pl_clock_t t0 = pl_clock_now();
+    NSString *src = [NSString stringWithUTF8String:msl];
+    id<MTLLibrary> lib = [device newLibraryWithSource:src options:opts error:&err];
+    if (!lib) {
+        PL_ERR(gpu, "Failed to compile MSL %s library: %s",
+               label, err.localizedDescription.UTF8String);
+        return nil;
+    }
+    pl_log_cpu_time(gpu->log, t0, pl_clock_now(), "compiling MSL to MTLLibrary");
+    return lib;
+}
+
+struct __attribute__((packed)) metal_msl_cache_header {
+    uint32_t vert_msl_len;
+    uint32_t frag_msl_len;
+    uint32_t comp_msl_len;
+};
+
+static uint64_t pass_cache_signature(pl_gpu gpu, const struct pl_pass_params *params)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    uint64_t hash = CACHE_KEY_METAL_MSL;
+    pl_hash_merge(&hash, pl_str0_hash(params->glsl_shader));
+    if (params->type == PL_PASS_RASTER)
+        pl_hash_merge(&hash, pl_str0_hash(params->vertex_shader));
+    pl_hash_merge(&hash, p->spirv->signature);
+    unsigned spvc_major, spvc_minor, spvc_patch;
+    spvc_get_version(&spvc_major, &spvc_minor, &spvc_patch);
+    pl_hash_merge(&hash, spvc_major);
+    pl_hash_merge(&hash, spvc_minor);
+    pl_hash_merge(&hash, spvc_patch);
+    return hash;
+}
+
+static bool metal_use_cached_msl(pl_gpu gpu, pl_pass pass,
+                                  const struct pl_pass_params *params,
+                                  pl_cache_obj *obj,
+                                  const char **out_vert, const char **out_frag,
+                                  const char **out_comp)
+{
+    const pl_cache gpu_cache = pl_gpu_cache(gpu);
+    obj->key = pass_cache_signature(gpu, params);
+    if (!gpu_cache || !pl_cache_get(gpu_cache, obj))
+        return false;
+
+    if (obj->size < sizeof(struct metal_msl_cache_header))
+        return false;
+
+    struct metal_msl_cache_header *hdr = obj->data;
+    size_t required = sizeof(*hdr) + hdr->vert_msl_len + hdr->frag_msl_len
+                                   + hdr->comp_msl_len;
+    if (obj->size < required)
+        return false;
+
+    const uint8_t *ptr = (const uint8_t *) obj->data + sizeof(*hdr);
+
+    if (out_vert) {
+        *out_vert = hdr->vert_msl_len
+            ? pl_strdup0((void *) pass, (pl_str){ (uint8_t *) ptr, hdr->vert_msl_len })
+            : NULL;
+    }
+    ptr += hdr->vert_msl_len;
+
+    if (out_frag) {
+        *out_frag = hdr->frag_msl_len
+            ? pl_strdup0((void *) pass, (pl_str){ (uint8_t *) ptr, hdr->frag_msl_len })
+            : NULL;
+    }
+    ptr += hdr->frag_msl_len;
+
+    if (out_comp) {
+        *out_comp = hdr->comp_msl_len
+            ? pl_strdup0((void *) pass, (pl_str){ (uint8_t *) ptr, hdr->comp_msl_len })
+            : NULL;
+    }
+
+    return true;
+}
+
+static void metal_update_msl_cache(pl_gpu gpu, uint64_t key,
+                                    const char *vert_msl, const char *frag_msl,
+                                    const char *comp_msl)
+{
+    const pl_cache gpu_cache = pl_gpu_cache(gpu);
+    if (!gpu_cache)
+        return;
+
+    uint32_t vlen = vert_msl ? strlen(vert_msl) : 0;
+    uint32_t flen = frag_msl ? strlen(frag_msl) : 0;
+    uint32_t clen = comp_msl ? strlen(comp_msl) : 0;
+
+    struct metal_msl_cache_header hdr = {
+        .vert_msl_len = vlen,
+        .frag_msl_len = flen,
+        .comp_msl_len = clen,
+    };
+
+    pl_str cache = {0};
+    pl_str_append(NULL, &cache, (pl_str){ (uint8_t *) &hdr, sizeof(hdr) });
+    if (vlen)
+        pl_str_append(NULL, &cache, (pl_str){ (uint8_t *) vert_msl, vlen });
+    if (flen)
+        pl_str_append(NULL, &cache, (pl_str){ (uint8_t *) frag_msl, flen });
+    if (clen)
+        pl_str_append(NULL, &cache, (pl_str){ (uint8_t *) comp_msl, clen });
+
+    pl_cache_str(gpu_cache, key, &cache);
+}
+
+static bool pass_create_compute(pl_gpu gpu, pl_pass pass,
+                                const struct pl_pass_params *params)
+{
+    struct pl_gpu_metal *p       = PL_PRIV(gpu);
+    struct pl_pass_metal *pass_p = PL_PRIV(pass);
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+    bool has_pushc = params->push_constants_size > 0;
+
+    // Declare early for ARC
+    id<MTLLibrary> lib  = nil;
+    id<MTLFunction> fn   = nil;
+    id<MTLComputePipelineState> pso  = nil;
+    NSError *err  = nil;
+    pl_cache_obj obj  = {0};
+    const char *msl  = NULL;
+    bool success = false;
+
+    bool from_cache = metal_use_cached_msl(gpu, pass, params, &obj,
+                                            NULL, NULL, &msl);
+    if (from_cache)
+        PL_DEBUG(gpu, "Using cached MSL compute shader");
+
+    if (!msl) {
+        msl = compile_glsl_to_msl(gpu, pass, GLSL_SHADER_COMPUTE,
+                                   params->glsl_shader,
+                                   has_pushc, pass_p->local_size);
+        if (!msl) goto error;
+    }
+
+    lib = make_library(gpu, device, msl, "compute");
+    if (!lib) goto error;
+
+    fn = [lib newFunctionWithName:@"main0"];
+    if (!fn) {
+        PL_ERR(gpu, "Compute library has no 'main0' entry point");
+        goto error;
+    }
+
+    pso = [device newComputePipelineStateWithFunction:fn error:&err];
+    if (!pso) {
+        PL_ERR(gpu, "Failed to create MTLComputePipelineState: %s",
+               err.localizedDescription.UTF8String);
+        goto error;
+    }
+
+    pass_p->is_compute = true;
+    pass_p->pso = (void *) CFBridgingRetain(pso);
+
+    if (has_pushc) {
+        for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+            id<MTLBuffer> pcbuf =
+                [device newBufferWithLength:params->push_constants_size
+                                    options:MTLResourceStorageModeShared];
+            if (!pcbuf) {
+                PL_ERR(gpu, "Failed to allocate push-constant buffer (slot %d)", i);
+                goto error;
+            }
+            pass_p->pushc_bufs[i] = (void *) CFBridgingRetain(pcbuf);
+        }
+        pass_p->pushc_slot = METAL_PUSH_CONST_BUF_IDX;
+    }
+
+    if (!from_cache)
+        metal_update_msl_cache(gpu, obj.key, NULL, NULL, msl);
+
+    success = true;
+error:
+    pl_cache_obj_free(&obj);
+    return success;
+}
+
+static bool pass_create_raster(pl_gpu gpu, pl_pass pass,
+                               const struct pl_pass_params *params)
+{
+    struct pl_gpu_metal *p       = PL_PRIV(gpu);
+    struct pl_pass_metal *pass_p = PL_PRIV(pass);
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+    bool has_pushc = params->push_constants_size > 0;
+
+    // Declare early for ARC
+    id<MTLLibrary> vert_lib = nil;
+    id<MTLLibrary> frag_lib = nil;
+    id<MTLFunction> vert_fn  = nil;
+    id<MTLFunction> frag_fn  = nil;
+    MTLRenderPipelineDescriptor *rp   = nil;
+    id<MTLRenderPipelineState> pso  = nil;
+    NSError *err  = nil;
+    pl_cache_obj obj  = {0};
+    const char *vert_msl = NULL, *frag_msl = NULL;
+    bool success = false;
+
+    bool from_cache = metal_use_cached_msl(gpu, pass, params, &obj,
+                                            &vert_msl, &frag_msl, NULL);
+    if (from_cache)
+        PL_DEBUG(gpu, "Using cached MSL raster shaders");
+
+    if (!vert_msl) {
+        vert_msl = compile_glsl_to_msl(gpu, pass, GLSL_SHADER_VERTEX,
+                                        params->vertex_shader, has_pushc, NULL);
+        if (!vert_msl) goto error;
+    }
+
+    if (!frag_msl) {
+        frag_msl = compile_glsl_to_msl(gpu, pass, GLSL_SHADER_FRAGMENT,
+                                        params->glsl_shader, has_pushc, NULL);
+        if (!frag_msl) goto error;
+    }
+
+    vert_lib = make_library(gpu, device, vert_msl, "vertex");
+    if (!vert_lib) goto error;
+
+    frag_lib = make_library(gpu, device, frag_msl, "fragment");
+    if (!frag_lib) goto error;
+
+    vert_fn = [vert_lib newFunctionWithName:@"main0"];
+    frag_fn = [frag_lib newFunctionWithName:@"main0"];
+    if (!vert_fn || !frag_fn) {
+        PL_ERR(gpu, "Raster library missing 'main0' entry point");
+        goto error;
+    }
+
+    rp = [MTLRenderPipelineDescriptor new];
+    rp.vertexFunction   = vert_fn;
+    rp.fragmentFunction = frag_fn;
+
+    rp.colorAttachments[0].pixelFormat = metal_plfmt(params->target_format);
+
+    if (params->blend_params) {
+        const struct pl_blend_params *bp = params->blend_params;
+        MTLRenderPipelineColorAttachmentDescriptor *ca = rp.colorAttachments[0];
+        ca.blendingEnabled             = YES;
+        ca.sourceRGBBlendFactor        = blend_factor(bp->src_rgb);
+        ca.destinationRGBBlendFactor   = blend_factor(bp->dst_rgb);
+        ca.rgbBlendOperation           = MTLBlendOperationAdd;
+        ca.sourceAlphaBlendFactor      = blend_factor(bp->src_alpha);
+        ca.destinationAlphaBlendFactor = blend_factor(bp->dst_alpha);
+        ca.alphaBlendOperation         = MTLBlendOperationAdd;
+    }
+
+    if (params->num_vertex_attribs > 0) {
+        MTLVertexDescriptor *vd = [MTLVertexDescriptor new];
+        for (int i = 0; i < params->num_vertex_attribs; i++) {
+            struct pl_vertex_attrib *va = &params->vertex_attribs[i];
+            MTLVertexFormat vfmt = pl_fmt_to_mtl_vertex(va->fmt);
+            if (vfmt == MTLVertexFormatInvalid) {
+                PL_ERR(gpu, "Unsupported vertex format for attribute '%s'",
+                       va->name);
+                goto error;
+            }
+            vd.attributes[va->location].format = vfmt;
+            vd.attributes[va->location].offset = va->offset;
+            vd.attributes[va->location].bufferIndex = 0;
+        }
+        vd.layouts[0].stride = params->vertex_stride;
+        vd.layouts[0].stepFunction = MTLVertexStepFunctionPerVertex;
+        rp.vertexDescriptor = vd;
+    }
+
+    pso = [device newRenderPipelineStateWithDescriptor:rp error:&err];
+    if (!pso) {
+        PL_ERR(gpu, "Failed to create MTLRenderPipelineState: %s",
+               err.localizedDescription.UTF8String);
+        goto error;
+    }
+
+    pass_p->is_compute = false;
+    pass_p->pso = (void *) CFBridgingRetain(pso);
+
+    if (has_pushc) {
+        for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+            id<MTLBuffer> pcbuf =
+                [device newBufferWithLength:params->push_constants_size
+                                    options:MTLResourceStorageModeShared];
+            if (!pcbuf) {
+                PL_ERR(gpu, "Failed to allocate push-constant buffer (slot %d)", i);
+                goto error;
+            }
+            pass_p->pushc_bufs[i] = (void *) CFBridgingRetain(pcbuf);
+        }
+        pass_p->pushc_slot = METAL_PUSH_CONST_BUF_IDX;
+    }
+
+    if (!from_cache)
+        metal_update_msl_cache(gpu, obj.key, vert_msl, frag_msl, NULL);
+
+    success = true;
+error:
+    pl_cache_obj_free(&obj);
+    return success;
+}
+
+int pl_metal_desc_namespace(pl_gpu gpu, enum pl_desc_type type)
+{
+    // All descriptors share a single binding-number space (same as Vulkan).
+    (void) gpu;
+    (void) type;
+    return 0;
+}
+
+pl_pass pl_metal_pass_create(pl_gpu gpu, const struct pl_pass_params *params)
+{
+    struct pl_pass_t *pass = pl_zalloc_obj(NULL, pass, struct pl_pass_metal);
+    pass->params = pl_pass_params_copy(pass, params);
+
+    bool ok = (params->type == PL_PASS_COMPUTE)
+        ? pass_create_compute(gpu, pass, params)
+        : pass_create_raster(gpu, pass, params);
+
+    if (!ok) {
+        pl_metal_pass_destroy(gpu, pass);
+        return NULL;
+    }
+
+    return pass;
+}
+
+void pl_metal_pass_destroy(pl_gpu gpu, pl_pass pass)
+{
+    (void) gpu;
+    struct pl_pass_metal *pass_p = PL_PRIV(pass);
+
+    if (pass_p->pso)
+        CFBridgingRelease(pass_p->pso);
+    for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+        if (pass_p->pushc_bufs[i])
+            CFBridgingRelease(pass_p->pushc_bufs[i]);
+    }
+
+    pl_free((void *) pass);
+}
+
+static void bind_descriptors_compute(pl_gpu gpu, pl_pass pass,
+                                     const struct pl_pass_run_params *params,
+                                     id<MTLComputeCommandEncoder> enc)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+
+    for (int i = 0; i < pass->params.num_descriptors; i++) {
+        const struct pl_desc *desc         = &pass->params.descriptors[i];
+        const struct pl_desc_binding *bind = &params->desc_bindings[i];
+        int slot = desc->binding;
+
+        switch (desc->type) {
+        case PL_DESC_SAMPLED_TEX: {
+            pl_tex tex = bind->object;
+            struct pl_tex_metal *tp = PL_PRIV(tex);
+            [enc setTexture:(__bridge id<MTLTexture>) tp->tex atIndex:slot];
+            id<MTLSamplerState> samp = (__bridge id<MTLSamplerState>)
+                p->samplers[bind->sample_mode][bind->address_mode];
+            [enc setSamplerState:samp atIndex:slot];
+            break;
+        }
+        case PL_DESC_STORAGE_IMG: {
+            pl_tex tex = bind->object;
+            struct pl_tex_metal *tp = PL_PRIV(tex);
+            [enc setTexture:(__bridge id<MTLTexture>) tp->tex atIndex:slot];
+            break;
+        }
+        case PL_DESC_BUF_UNIFORM:
+        case PL_DESC_BUF_STORAGE:
+        case PL_DESC_BUF_TEXEL_UNIFORM:
+        case PL_DESC_BUF_TEXEL_STORAGE: {
+            pl_buf buf = bind->object;
+            struct pl_buf_metal *bp = PL_PRIV(buf);
+            [enc setBuffer:(__bridge id<MTLBuffer>) bp->buf offset:0 atIndex:slot];
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
+
+static void bind_descriptors_raster(pl_gpu gpu, pl_pass pass,
+                                    const struct pl_pass_run_params *params,
+                                    id<MTLRenderCommandEncoder> enc)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+
+    for (int i = 0; i < pass->params.num_descriptors; i++) {
+        const struct pl_desc *desc         = &pass->params.descriptors[i];
+        const struct pl_desc_binding *bind = &params->desc_bindings[i];
+        int slot = desc->binding;
+
+        switch (desc->type) {
+        case PL_DESC_SAMPLED_TEX: {
+            pl_tex tex = bind->object;
+            struct pl_tex_metal *tp = PL_PRIV(tex);
+            id<MTLTexture> mtl_tex = (__bridge id<MTLTexture>) tp->tex;
+            [enc setFragmentTexture:mtl_tex atIndex:slot];
+            id<MTLSamplerState> samp = (__bridge id<MTLSamplerState>)
+                p->samplers[bind->sample_mode][bind->address_mode];
+            [enc setFragmentSamplerState:samp atIndex:slot];
+            break;
+        }
+        case PL_DESC_STORAGE_IMG: {
+            pl_tex tex = bind->object;
+            struct pl_tex_metal *tp = PL_PRIV(tex);
+            id<MTLTexture> mtl_tex = (__bridge id<MTLTexture>) tp->tex;
+            [enc setFragmentTexture:mtl_tex atIndex:slot];
+            break;
+        }
+        case PL_DESC_BUF_UNIFORM:
+        case PL_DESC_BUF_STORAGE: {
+            pl_buf buf = bind->object;
+            struct pl_buf_metal *bp = PL_PRIV(buf);
+            id<MTLBuffer> mtl_buf = (__bridge id<MTLBuffer>) bp->buf;
+            // Vertex stage: +1 because slot 0 is the vertex data buffer.
+            // The MSL is compiled with the same +1 remap (see compile_glsl_to_msl).
+            [enc setVertexBuffer:mtl_buf offset:0 atIndex:slot + 1];
+            [enc setFragmentBuffer:mtl_buf offset:0 atIndex:slot];
+            break;
+        }
+        case PL_DESC_BUF_TEXEL_UNIFORM:
+        case PL_DESC_BUF_TEXEL_STORAGE: {
+            // Not supported yet
+            pl_buf buf = bind->object;
+            struct pl_buf_metal *bp = PL_PRIV(buf);
+            id<MTLBuffer> mtl_buf = (__bridge id<MTLBuffer>) bp->buf;
+            [enc setVertexBuffer:mtl_buf offset:0 atIndex:slot + 1];
+            [enc setFragmentBuffer:mtl_buf offset:0 atIndex:slot];
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
+
+static void pass_run_compute(pl_gpu gpu, const struct pl_pass_run_params *params,
+                             pl_timer timer)
+{
+    struct pl_gpu_metal *p     = PL_PRIV(gpu);
+    pl_pass pass               = params->pass;
+    struct pl_pass_metal *pass_p   = PL_PRIV(pass);
+
+    void *cur_pushc = pass_p->pushc_bufs[p->frame_index];
+    if (cur_pushc && params->push_constants) {
+        id<MTLBuffer> pcbuf = (__bridge id<MTLBuffer>) cur_pushc;
+        memcpy(pcbuf.contents, params->push_constants,
+               pass->params.push_constants_size);
+    }
+
+    id<MTLCommandBuffer> cmd = metal_cmd_get(p);
+    id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+
+    id<MTLComputePipelineState> pso =
+        (__bridge id<MTLComputePipelineState>) pass_p->pso;
+    [enc setComputePipelineState:pso];
+
+    if (cur_pushc)
+        [enc setBuffer:(__bridge id<MTLBuffer>) cur_pushc
+                offset:0
+               atIndex:pass_p->pushc_slot];
+
+    bind_descriptors_compute(gpu, pass, params, enc);
+
+    MTLSize groups_per_grid = MTLSizeMake(params->compute_groups[0],
+                                          params->compute_groups[1],
+                                          params->compute_groups[2]);
+    MTLSize threads_per_group = MTLSizeMake(pass_p->local_size[0],
+                                             pass_p->local_size[1],
+                                             pass_p->local_size[2]);
+    [enc dispatchThreadgroups:groups_per_grid
+        threadsPerThreadgroup:threads_per_group];
+
+    // sampleCountersInBuffer: is intentionally not called here. Apple Silicon
+    // GPUs assert-fault on it for both compute and render encoders even
+    // when supportsCounterSampling:atStageBoundary returns YES. Timer support
+    // is therefore disabled for all Apple-family GPUs in pl_gpu_create_metal.
+    [enc endEncoding];
+}
+
+static void pass_run_raster(pl_gpu gpu, const struct pl_pass_run_params *params,
+                            pl_timer timer)
+{
+    struct pl_gpu_metal *p     = PL_PRIV(gpu);
+    pl_pass pass               = params->pass;
+    struct pl_pass_metal *pass_p   = PL_PRIV(pass);
+    pl_tex target              = params->target;
+
+    void *cur_pushc = pass_p->pushc_bufs[p->frame_index];
+    if (cur_pushc && params->push_constants) {
+        id<MTLBuffer> pcbuf = (__bridge id<MTLBuffer>) cur_pushc;
+        memcpy(pcbuf.contents, params->push_constants,
+               pass->params.push_constants_size);
+    }
+
+    struct pl_tex_metal *tp = PL_PRIV(target);
+    id<MTLTexture> target_tex = (__bridge id<MTLTexture>) tp->tex;
+
+    id<MTLCommandBuffer> cmd = metal_cmd_get(p);
+
+    MTLRenderPassDescriptor *rpd = [MTLRenderPassDescriptor renderPassDescriptor];
+    rpd.colorAttachments[0].texture     = target_tex;
+    rpd.colorAttachments[0].storeAction = MTLStoreActionStore;
+    // Use DontCare if the pass does not need to preserve previous contents.
+    rpd.colorAttachments[0].loadAction  = pass->params.load_target
+        ? MTLLoadActionLoad : MTLLoadActionDontCare;
+
+    id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:rpd];
+
+    id<MTLRenderPipelineState> pso =
+        (__bridge id<MTLRenderPipelineState>) pass_p->pso;
+    [enc setRenderPipelineState:pso];
+
+    pl_rect2d vp = params->viewport;
+    if (!pl_rect_w(vp) && !pl_rect_h(vp)) {
+        vp = (pl_rect2d) { 0, 0, target->params.w, target->params.h };
+    }
+    [enc setViewport:(MTLViewport) {
+        .originX = vp.x0, .originY = vp.y0,
+        .width   = pl_rect_w(vp), .height = pl_rect_h(vp),
+        .znear = 0.0, .zfar = 1.0,
+    }];
+
+    pl_rect2d sc = params->scissors;
+    if (!pl_rect_w(sc) && !pl_rect_h(sc)) {
+        sc = (pl_rect2d) { 0, 0, target->params.w, target->params.h };
+    }
+    [enc setScissorRect:(MTLScissorRect) {
+        .x = sc.x0, .y = sc.y0,
+        .width  = sc.x1 - sc.x0,
+        .height = sc.y1 - sc.y0,
+    }];
+
+    if (cur_pushc) {
+        id<MTLBuffer> pcbuf = (__bridge id<MTLBuffer>) cur_pushc;
+        [enc setVertexBuffer:pcbuf offset:0 atIndex:pass_p->pushc_slot];
+        [enc setFragmentBuffer:pcbuf offset:0 atIndex:pass_p->pushc_slot];
+    }
+
+    bind_descriptors_raster(gpu, pass, params, enc);
+
+    if (params->vertex_data) {
+        size_t vtx_size = pl_vertex_buf_size(params);
+
+        if (vtx_size <= 4096) {
+            // Small data: use setVertexBytes (no buffer allocation needed).
+            [enc setVertexBytes:params->vertex_data
+                         length:vtx_size
+                        atIndex:0];
+        } else {
+            // Larger data: copy into the current frame's slot of the vtx_buf
+            // ring.  This avoids CPU/GPU races when frames overlap on the GPU.
+            int fslot = (int) p->frame_index;
+
+            if (vtx_size > p->vtx_buf_size) {
+                // New size needed: free all ring slots (Metal retains its own
+                // references on any in-flight command buffers, so this is safe).
+                for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+                    if (p->vtx_bufs[i]) {
+                        CFBridgingRelease(p->vtx_bufs[i]);
+                        p->vtx_bufs[i] = NULL;
+                    }
+                }
+                p->vtx_buf_size = vtx_size;
+            }
+
+            if (!p->vtx_bufs[fslot]) {
+                id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+                id<MTLBuffer> buf = [device newBufferWithLength:p->vtx_buf_size
+                                                       options:MTLResourceStorageModeShared];
+                if (!buf) {
+                    PL_ERR(gpu, "Failed to allocate vertex buffer (slot %d, size %zu)",
+                           fslot, p->vtx_buf_size);
+                    [enc endEncoding];
+                    return;
+                }
+                p->vtx_bufs[fslot] = (void *) CFBridgingRetain(buf);
+            }
+
+            id<MTLBuffer> vtx_buf = (__bridge id<MTLBuffer>) p->vtx_bufs[fslot];
+            memcpy(vtx_buf.contents, params->vertex_data, vtx_size);
+            [enc setVertexBuffer:vtx_buf offset:0 atIndex:0];
+        }
+    } else if (params->vertex_buf) {
+        struct pl_buf_metal *vbp = PL_PRIV(params->vertex_buf);
+        [enc setVertexBuffer:(__bridge id<MTLBuffer>) vbp->buf
+                      offset:params->buf_offset
+                     atIndex:0];
+    }
+
+    static const MTLPrimitiveType prim_types[PL_PRIM_TYPE_COUNT] = {
+        [PL_PRIM_TRIANGLE_LIST]  = MTLPrimitiveTypeTriangle,
+        [PL_PRIM_TRIANGLE_STRIP] = MTLPrimitiveTypeTriangleStrip,
+    };
+    MTLPrimitiveType prim = prim_types[pass->params.vertex_type];
+
+    if (params->index_data || params->index_buf) {
+        static const MTLIndexType idx_types[PL_INDEX_FORMAT_COUNT] = {
+            [PL_INDEX_UINT16] = MTLIndexTypeUInt16,
+            [PL_INDEX_UINT32] = MTLIndexTypeUInt32,
+        };
+        MTLIndexType idx_type = idx_types[params->index_fmt];
+
+        if (params->index_data) {
+            size_t idx_size = pl_index_buf_size(params);
+            int fslot = (int) p->frame_index;
+
+            if (idx_size > p->idx_buf_size) {
+                for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+                    if (p->idx_bufs[i]) {
+                        CFBridgingRelease(p->idx_bufs[i]);
+                        p->idx_bufs[i] = NULL;
+                    }
+                }
+                p->idx_buf_size = idx_size;
+            }
+
+            if (!p->idx_bufs[fslot]) {
+                id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+                id<MTLBuffer> buf = [device newBufferWithLength:p->idx_buf_size
+                                                       options:MTLResourceStorageModeShared];
+                if (!buf) {
+                    PL_ERR(gpu, "Failed to allocate index buffer (slot %d, size %zu)",
+                           fslot, p->idx_buf_size);
+                    [enc endEncoding];
+                    return;
+                }
+                p->idx_bufs[fslot] = (void *) CFBridgingRetain(buf);
+            }
+
+            id<MTLBuffer> idx_buf = (__bridge id<MTLBuffer>) p->idx_bufs[fslot];
+            memcpy(idx_buf.contents, params->index_data, idx_size);
+            [enc drawIndexedPrimitives:prim
+                            indexCount:params->vertex_count
+                             indexType:idx_type
+                           indexBuffer:idx_buf
+                     indexBufferOffset:0];
+        } else {
+            struct pl_buf_metal *ibp = PL_PRIV(params->index_buf);
+            [enc drawIndexedPrimitives:prim
+                            indexCount:params->vertex_count
+                             indexType:idx_type
+                           indexBuffer:(__bridge id<MTLBuffer>) ibp->buf
+                     indexBufferOffset:params->index_offset];
+        }
+    } else {
+        [enc drawPrimitives:prim
+                vertexStart:0
+                vertexCount:params->vertex_count];
+    }
+
+    [enc endEncoding];
+}
+
+void pl_metal_pass_run(pl_gpu gpu, const struct pl_pass_run_params *params)
+{
+    pl_pass pass = params->pass;
+    struct pl_pass_metal *pp = PL_PRIV(pass);
+    pl_timer timer = params->timer;
+
+    if (pp->is_compute) {
+        pass_run_compute(gpu, params, timer);
+    } else {
+        pass_run_raster(gpu, params, timer);
+    }
+}
diff --git a/src/metal/gpu_tex.m b/src/metal/gpu_tex.m
new file mode 100644
index 0000000..64711b7
--- /dev/null
+++ b/src/metal/gpu_tex.m
@@ -0,0 +1,470 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
