new file mode 100644
index 0000000..8567fda
--- /dev/null
+++ b/src/metal/swapchain.m
@@ -0,0 +1,351 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+#include "metal_ops.h"
+#include "../swapchain.h"
+
+#import <QuartzCore/CAMetalLayer.h>
+
+struct metal_sw {
+    struct pl_sw_fns impl;
+
+    pl_metal metal;
+    struct pl_metal_swapchain_params params;
+
+    // Set between start_frame and submit_frame.
+    void *cur_drawable; // id<CAMetalDrawable>  (CFBridgingRetain'd)
+    pl_tex backbuffer;
+
+    // Ring of retained command buffers for in-flight frames.
+    // swap_buffers blocks on frame_cmds[frame_head] only when the ring is full,
+    // allowing up to max_drawables frames to overlap on the GPU simultaneously.
+    void *frame_cmds[METAL_MAX_IN_FLIGHT]; // id<MTLCommandBuffer>, CFBridgingRetain'd
+    int frame_head;    // index of the oldest in-flight entry
+    int frame_count;   // number of entries currently occupied
+    int max_drawables; // cached layer.maximumDrawableCount
+
+    // Last color space received via colorspace_hint.
+    struct pl_color_space sw_color_space;
+};
+
+static void metal_sw_destroy(pl_swapchain sw)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    pl_gpu gpu = sw->gpu;
+
+    // Drain all in-flight frames so GPU work completes before we free resources.
+    for (int i = 0; i < p->frame_count; i++) {
+        int idx = (p->frame_head + i) % METAL_MAX_IN_FLIGHT;
+        if (p->frame_cmds[idx]) {
+            [(__bridge id<MTLCommandBuffer>) p->frame_cmds[idx] waitUntilCompleted];
+            CFBridgingRelease(p->frame_cmds[idx]);
+            p->frame_cmds[idx] = NULL;
+        }
+    }
+    p->frame_count = 0;
+
+    pl_tex_destroy(gpu, &p->backbuffer);
+
+    if (p->cur_drawable) {
+        CFBridgingRelease(p->cur_drawable);
+        p->cur_drawable = NULL;
+    }
+
+    pl_free((void *) sw);
+}
+
+static int metal_sw_latency(pl_swapchain sw)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    return p->max_drawables;
+}
+
+static CGColorSpaceRef pick_cg_colorspace(const struct pl_color_space *csp)
+{
+    if (!csp || !pl_color_transfer_is_hdr(csp->transfer)) {
+        // SDR
+        return CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    }
+
+    switch (csp->transfer) {
+    case PL_COLOR_TRC_SCRGB:
+        return CGColorSpaceCreateWithName(kCGColorSpaceExtendedLinearSRGB);
+
+    case PL_COLOR_TRC_HLG:
+        return CGColorSpaceCreateWithName(kCGColorSpaceITUR_2100_HLG);
+
+    default:
+        if (csp->primaries == PL_COLOR_PRIM_DISPLAY_P3)
+            return CGColorSpaceCreateWithName(kCGColorSpaceDisplayP3_PQ);
+        return CGColorSpaceCreateWithName(kCGColorSpaceITUR_2100_PQ);
+    }
+}
+
+static void metal_sw_colorspace_hint(pl_swapchain sw,
+                                      const struct pl_color_space *csp)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    CAMetalLayer *layer = (__bridge CAMetalLayer *) p->params.layer;
+
+    bool hdr = csp && pl_color_transfer_is_hdr(csp->transfer);
+
+    if (hdr) {
+        if (csp->transfer == PL_COLOR_TRC_SCRGB) {
+            layer.pixelFormat = MTLPixelFormatRGBA16Float;
+        } else {
+            layer.pixelFormat = MTLPixelFormatBGRA10_XR;
+        }
+        layer.wantsExtendedDynamicRangeContent = YES;
+    } else {
+        layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+        layer.wantsExtendedDynamicRangeContent = NO;
+    }
+
+    CGColorSpaceRef cgs = pick_cg_colorspace(csp);
+    layer.colorspace = cgs;
+    CGColorSpaceRelease(cgs);
+
+    p->sw_color_space = csp ? *csp : pl_color_space_srgb;
+
+    PL_DEBUG(sw, "colorspace_hint: %s → pixelFormat %lu, EDR=%s",
+             hdr ? "HDR" : "SDR",
+             (unsigned long) layer.pixelFormat,
+             hdr ? "yes" : "no");
+}
+
+static bool metal_sw_resize(pl_swapchain sw, int *width, int *height)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    CAMetalLayer *layer = (__bridge CAMetalLayer *) p->params.layer;
+
+    CGSize cur = layer.drawableSize;
+    int w = PL_DEF(*width,  (int) cur.width);
+    int h = PL_DEF(*height, (int) cur.height);
+    if (w <= 0) w = 1;
+    if (h <= 0) h = 1;
+
+    if (w != (int) cur.width || h != (int) cur.height) {
+        if (p->backbuffer) {
+            PL_ERR(sw, "Tried resizing swapchain while a frame was in progress! "
+                   "Submit the current frame first.");
+            return false;
+        }
+        layer.drawableSize = CGSizeMake(w, h);
+    }
+
+    *width  = w;
+    *height = h;
+    return true;
+}
+
+static bool metal_sw_start_frame(pl_swapchain sw,
+                                  struct pl_swapchain_frame *out_frame)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    pl_gpu gpu = sw->gpu;
+    struct pl_gpu_metal *gp = PL_PRIV(gpu);
+
+    if (gp->ctx->failed)
+        return false;
+
+    if (p->backbuffer) {
+        PL_ERR(sw, "Attempted calling pl_swapchain_start_frame while a frame "
+               "was already in progress! Call pl_swapchain_submit_frame first.");
+        return false;
+    }
+
+    CAMetalLayer *layer = (__bridge CAMetalLayer *) p->params.layer;
+    id<CAMetalDrawable> drawable = [layer nextDrawable];
+    if (!drawable) {
+        PL_ERR(sw, "CAMetalLayer.nextDrawable returned nil (timeout or "
+               "maximumDrawableCount exceeded)");
+        return false;
+    }
+
+    p->cur_drawable = (void *) CFBridgingRetain(drawable);
+
+    p->backbuffer = pl_metal_wrap(gpu, pl_metal_wrap_params(
+        .texture = (__bridge void *) drawable.texture,
+    ));
+    if (!p->backbuffer) {
+        PL_ERR(sw, "Failed wrapping CAMetalDrawable texture as pl_tex");
+        CFBridgingRelease(p->cur_drawable);
+        p->cur_drawable = NULL;
+        return false;
+    }
+
+    struct pl_color_space frame_csp = p->sw_color_space;
+
+    // Infer bit depth from the pixel format as pl_color_space doesn't have this.
+    MTLPixelFormat pf = layer.pixelFormat;
+    int depth_bits = (pf == MTLPixelFormatRGBA16Float) ? 16 :
+                     (pf == MTLPixelFormatBGRA10_XR)   ? 10 : 8;
+
+    *out_frame = (struct pl_swapchain_frame) {
+        .fbo     = p->backbuffer,
+        .flipped = false,
+        .color_repr = {
+            .sys    = PL_COLOR_SYSTEM_RGB,
+            .levels = PL_COLOR_LEVELS_FULL,
+            .alpha  = PL_ALPHA_UNKNOWN,
+            .bits   = {
+                .sample_depth = depth_bits,
+                .color_depth  = depth_bits,
+            },
+        },
+        .color_space = frame_csp,
+    };
+
+    return true;
+}
+
+static bool metal_sw_submit_frame(pl_swapchain sw)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    pl_gpu gpu = sw->gpu;
+    struct pl_gpu_metal *gp = PL_PRIV(gpu);
+
+    // Release the backbuffer wrapper. The underlying MTLTexture is owned by
+    // the CAMetalDrawable and must not be freed.
+    pl_tex_destroy(gpu, &p->backbuffer);
+
+    if (p->cur_drawable) {
+        id<CAMetalDrawable> drawable =
+            (__bridge id<CAMetalDrawable>) p->cur_drawable;
+
+        id<MTLCommandBuffer> cmd = metal_cmd_get(gp);
+        [cmd presentDrawable:drawable];
+
+        // Push into the in-flight ring
+        int slot = (p->frame_head + p->frame_count) % METAL_MAX_IN_FLIGHT;
+        if (p->frame_cmds[slot])
+            CFBridgingRelease(p->frame_cmds[slot]);
+        p->frame_cmds[slot] = (void *) CFBridgingRetain(cmd);
+        p->frame_count++;
+
+        // Advance the frame slot for the next frame's per-frame resources
+        gp->frame_index = (gp->frame_index + 1) % METAL_MAX_IN_FLIGHT;
+
+        // Commit non-blocking; swap_buffers waits only when the ring is full.
+        metal_cmd_submit(gp, false);
+
+        CFBridgingRelease(p->cur_drawable);
+        p->cur_drawable = NULL;
+    }
+
+    return !gp->ctx->failed;
+}
+
+static void metal_sw_swap_buffers(pl_swapchain sw)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    struct pl_gpu_metal *gp = PL_PRIV(sw->gpu);
+
+    // Retire the oldest in-flight frame only when the ring is full. nextDrawable
+    // in start_frame provides the matching back-pressure on the display side.
+    while (p->frame_count >= p->max_drawables) {
+        id<MTLCommandBuffer> cmd =
+            (__bridge id<MTLCommandBuffer>) p->frame_cmds[p->frame_head];
+        [cmd waitUntilCompleted];
+
+        if (cmd.status == MTLCommandBufferStatusError) {
+            NSString *desc = cmd.error ? cmd.error.localizedDescription : @"(no info)";
+            PL_ERR(sw->gpu, "Metal command buffer GPU error: %s",
+                   desc.UTF8String);
+            gp->ctx->failed = true;
+            // Release this slot and stop — start_frame will fail on failed flag.
+            CFBridgingRelease(p->frame_cmds[p->frame_head]);
+            p->frame_cmds[p->frame_head] = NULL;
+            p->frame_head = (p->frame_head + 1) % METAL_MAX_IN_FLIGHT;
+            p->frame_count--;
+            break;
+        }
+
+        CFBridgingRelease(p->frame_cmds[p->frame_head]);
+        p->frame_cmds[p->frame_head] = NULL;
+        p->frame_head = (p->frame_head + 1) % METAL_MAX_IN_FLIGHT;
+        p->frame_count--;
+    }
+}
+
+static const struct pl_sw_fns metal_swapchain = {
+    .destroy          = metal_sw_destroy,
+    .latency          = metal_sw_latency,
+    .resize           = metal_sw_resize,
+    .colorspace_hint  = metal_sw_colorspace_hint,
+    .start_frame      = metal_sw_start_frame,
+    .submit_frame     = metal_sw_submit_frame,
+    .swap_buffers     = metal_sw_swap_buffers,
+};
+
+pl_swapchain pl_metal_create_swapchain(pl_metal metal,
+    const struct pl_metal_swapchain_params *params)
+{
+    pl_gpu gpu = metal->gpu;
+
+    if (!params->layer) {
+        PL_ERR(gpu, "pl_metal_create_swapchain: layer is NULL");
+        return NULL;
+    }
+
+    CAMetalLayer *layer = (__bridge CAMetalLayer *) params->layer;
+    id<MTLDevice> device = (__bridge id<MTLDevice>) metal->device;
+
+    layer.device = device;
+
+    // Default to BGRA8Unorm only when the layer hasn't been pre-configured
+    if (layer.pixelFormat == MTLPixelFormatInvalid)
+        layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+
+    // Keep framebuffer-only mode: the layer is always a render destination,
+    // never a shader source. This lets Metal keep attachments in on-chip tile
+    // memory.
+    layer.framebufferOnly = YES;
+
+    layer.displaySyncEnabled = YES;
+
+    if (params->maximum_drawables > 0) {
+        NSUInteger max = (NSUInteger) PL_CLAMP(params->maximum_drawables, 2, 3);
+        layer.maximumDrawableCount = max;
+    }
+
+    struct pl_swapchain_t *sw = pl_zalloc_obj(NULL, sw, struct metal_sw);
+    *sw = (struct pl_swapchain_t) {
+        .log = gpu->log,
+        .gpu = gpu,
+    };
+
+    struct metal_sw *p = PL_PRIV(sw);
+    *p = (struct metal_sw) {
+        .impl          = metal_swapchain,
+        .metal         = metal,
+        .params        = *params,
+        .max_drawables = (int) layer.maximumDrawableCount,
+    };
+    p->sw_color_space = pl_color_space_srgb;
+
+    PL_INFO(gpu, "Created Metal swapchain (%d drawables)", p->max_drawables);
+
+    return sw;
+}
+
+void *pl_metal_swapchain_unwrap(pl_swapchain sw)
+{
+    struct metal_sw *p = PL_PRIV(sw);
+    return p->params.layer;
+}
