+ */
+
+// Internal ObjC helpers. Must ONLY be included from .m files.
+
+#pragma once
+
+#ifdef __OBJC__
+
+#import <Metal/Metal.h>
+
+#include "gpu.h"
+
+static inline void metal_blit_enc_end(struct pl_gpu_metal *p)
+{
+    if (!p->blit_enc) return;
+    [(__bridge id<MTLBlitCommandEncoder>) p->blit_enc endEncoding];
+    CFBridgingRelease(p->blit_enc);
+    p->blit_enc = NULL;
+}
+
+// Implicitly creates a command buffer if none is pending.
+static inline id<MTLBlitCommandEncoder> metal_blit_enc_get(struct pl_gpu_metal *p)
+{
+    if (!p->blit_enc) {
+        if (!p->cmd_buf) {
+            id<MTLCommandQueue> q =
+                (__bridge id<MTLCommandQueue>) p->ctx->metal->command_queue;
+            p->cmd_buf = (void *) CFBridgingRetain([q commandBuffer]);
+        }
+        id<MTLCommandBuffer> cmd = (__bridge id<MTLCommandBuffer>) p->cmd_buf;
+        p->blit_enc = (void *) CFBridgingRetain([cmd blitCommandEncoder]);
+    }
+    return (__bridge id<MTLBlitCommandEncoder>) p->blit_enc;
+}
+
+// Ends any open blit encoder first, so a render or compute encoder can follow.
+static inline id<MTLCommandBuffer> metal_cmd_get(struct pl_gpu_metal *p)
+{
+    metal_blit_enc_end(p);
+    if (!p->cmd_buf) {
+        id<MTLCommandQueue> q =
+            (__bridge id<MTLCommandQueue>) p->ctx->metal->command_queue;
+        p->cmd_buf = (void *) CFBridgingRetain([q commandBuffer]);
+    }
+    return (__bridge id<MTLCommandBuffer>) p->cmd_buf;
+}
+
+static inline void metal_cmd_submit(struct pl_gpu_metal *p, bool wait)
+{
+    metal_blit_enc_end(p);
+    if (!p->cmd_buf) return;
+    id<MTLCommandBuffer> cmd = (__bridge id<MTLCommandBuffer>) p->cmd_buf;
+    [cmd commit];
+    if (wait)
+        [cmd waitUntilCompleted];
+    CFBridgingRelease(p->cmd_buf);
+    p->cmd_buf = NULL;
+}
+
+// Non-blocking commit that keeps `staging` alive until GPU completion via a
+// completion handler. The host pointer is safe to reuse immediately since Metal
+// already copied it; in-order queue semantics ensure subsequent command buffers
+// see the completed blit without extra synchronisation.
+static inline void metal_cmd_submit_with_staging(struct pl_gpu_metal *p,
+                                                  id<MTLBuffer> staging)
+{
+    metal_blit_enc_end(p);
+    if (!p->cmd_buf) return;
+    id<MTLCommandBuffer> cmd = (__bridge id<MTLCommandBuffer>) p->cmd_buf;
+    // The __block retains `staging` in the heap-allocated block; the block is
+    // released (and staging with it) when the completion handler fires.
+    id<MTLBuffer> __block held_staging = staging;
+    [cmd addCompletedHandler:^(id<MTLCommandBuffer> __unused cb) {
+        held_staging = nil;
+    }];
+    [cmd commit];
+    CFBridgingRelease(p->cmd_buf);
+    p->cmd_buf = NULL;
+}
+
+static inline MTLPixelFormat metal_plfmt(pl_fmt fmt)
+{
+    const MTLPixelFormat *p = PL_PRIV(fmt);
+    return *p;
+}
+
+#endif // __OBJC__
