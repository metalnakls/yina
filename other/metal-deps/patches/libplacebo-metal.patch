diff --git a/src/include/libplacebo/metal.h b/src/include/libplacebo/metal.h
new file mode 100644
index 0000000..dae8af2
--- /dev/null
+++ b/src/include/libplacebo/metal.h
@@ -0,0 +1,113 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef LIBPLACEBO_METAL_H_
+#define LIBPLACEBO_METAL_H_
+
+#include <libplacebo/gpu.h>
+#include <libplacebo/swapchain.h>
+
+PL_API_BEGIN
+
+// Structure representing the actual Metal device and associated GPU instance.
+// `device` and `command_queue` are `id<MTLDevice>` and `id<MTLCommandQueue>`
+// respectively, stored as `void *` to keep this header usable from plain C/C++.
+typedef const struct pl_metal_t {
+    pl_gpu gpu;
+    void *device;
+    void *command_queue;
+} *pl_metal;
+
+struct pl_metal_params {
+    // Optional. If NULL, libplacebo selects the system default device via
+    // MTLCreateSystemDefaultDevice.
+    void *device;
+
+    // Optional. If NULL, libplacebo creates a new MTLCommandQueue from `device`.
+    // Ignored if `device` is also NULL.
+    void *command_queue;
+
+    // Disables the use of compute shaders. Some devices/drivers perform better
+    // without them.
+    bool no_compute;
+};
+
+#define PL_METAL_DEFAULTS
+#define pl_metal_params(...) (&(struct pl_metal_params) { PL_METAL_DEFAULTS __VA_ARGS__ })
+PL_API extern const struct pl_metal_params pl_metal_default_params;
+
+// Creates a new Metal backend based on the given parameters. If `params` is
+// left as NULL, it defaults to `&pl_metal_default_params`.
+PL_API pl_metal pl_metal_create(pl_log log, const struct pl_metal_params *params);
+
+// Destroys the Metal backend. All objects allocated from `metal->gpu` must be
+// explicitly destroyed by the user before calling this.
+PL_API void pl_metal_destroy(pl_metal *metal);
+
+// For a `pl_gpu` backed by Metal, this function retrieves the underlying
+// backend wrapper. Returns NULL for any other backend type.
+PL_API pl_metal pl_metal_get(pl_gpu gpu);
+
+struct pl_metal_swapchain_params {
+    // The `CAMetalLayer *` to present to. Required.
+    void *layer;
+
+    // Maximum number of drawables to keep in flight, clamped to [2, 3].
+    // If 0, the layer's existing maximumDrawableCount is left unchanged.
+    int maximum_drawables;
+};
+
+#define pl_metal_swapchain_params(...) (&(struct pl_metal_swapchain_params) { __VA_ARGS__ })
+
+// Creates a Metal swapchain tied to the provided layer. The caller retains
+// ownership of the layer for the lifetime of the swapchain; libplacebo holds
+// a non-owning reference and will not release it.
+PL_API pl_swapchain pl_metal_create_swapchain(pl_metal metal,
+    const struct pl_metal_swapchain_params *params);
+
+// Returns the `CAMetalLayer *` (as `void *`) backing a Metal swapchain.
+// The returned pointer is a non-owning borrow — do not CFRelease it.
+PL_API void *pl_metal_swapchain_unwrap(pl_swapchain sw);
+
+struct pl_metal_wrap_params {
+    // The `id<MTLTexture>` to wrap. Required.
+    void *texture;
+
+    // Optional user data copied into `pl_tex_params.user_data`.
+    void *user_data;
+
+    // Optional debug tag used for diagnostics.
+    pl_debug_tag debug_tag;
+};
+
+#define pl_metal_wrap_params(...) (&(struct pl_metal_wrap_params) {         \
+        .debug_tag = PL_DEBUG_TAG,                                          \
+        __VA_ARGS__                                                         \
+    })
+
+// Wraps an external Metal texture (`id<MTLTexture>`) in a `pl_tex` abstraction.
+// A reference to the texture is held until `pl_tex_destroy` is called.
+// Returns NULL on failure (unsupported format, mipmapped, multisampled, etc.)
+PL_API pl_tex pl_metal_wrap(pl_gpu gpu, const struct pl_metal_wrap_params *params);
+
+// Returns the underlying `id<MTLTexture>` (as a non-owning `void *`) from a
+// `pl_tex` created by `pl_metal_wrap`. Do not CFRelease the result.
+PL_API void *pl_metal_unwrap(pl_gpu gpu, pl_tex tex);
+
+PL_API_END
+
+#endif // LIBPLACEBO_METAL_H_
\ No newline at end of file
