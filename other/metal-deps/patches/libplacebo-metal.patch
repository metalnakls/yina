diff --git a/src/tests/metal.m b/src/tests/metal.m
new file mode 100644
index 0000000..9d2bbb1
--- /dev/null
+++ b/src/tests/metal.m
@@ -0,0 +1,141 @@
+#include "gpu_tests.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+#include <libplacebo/metal.h>
+#include <libplacebo/renderer.h>
+
+static void metal_interop_tests(pl_metal metal)
+{
+    pl_gpu gpu = metal->gpu;
+
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_UNORM, 4, 0, 0,
+                             PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_BLITTABLE);
+    if (!fmt)
+        return;
+
+    printf("metal_interop_tests:\n");
+
+    pl_tex export = pl_tex_create(gpu, pl_tex_params(
+        .w          = 32,
+        .h          = 32,
+        .format     = fmt,
+        .sampleable = true,
+        .renderable = true,
+        .blit_src   = !!(fmt->caps & PL_FMT_CAP_BLITTABLE),
+        .blit_dst   = !!(fmt->caps & PL_FMT_CAP_BLITTABLE),
+    ));
+    REQUIRE(export);
+
+    // Unwrap to the underlying id<MTLTexture>, re-wrap and verify caps round-trip
+    void *raw = pl_metal_unwrap(gpu, export);
+    REQUIRE(raw);
+
+    pl_tex import = pl_metal_wrap(gpu, pl_metal_wrap_params(
+        .texture = raw,
+    ));
+    REQUIRE(import);
+    REQUIRE_CMP(import->params.w,      ==, export->params.w,      "d");
+    REQUIRE_CMP(import->params.h,      ==, export->params.h,      "d");
+    REQUIRE_CMP(import->params.format, ==, export->params.format, "p");
+    REQUIRE(import->params.renderable);
+
+    pl_tex_destroy(gpu, &import);
+    pl_tex_destroy(gpu, &export);
+}
+
+static void metal_swapchain_tests(pl_metal metal)
+{
+    printf("metal_swapchain_tests:\n");
+    pl_gpu gpu = metal->gpu;
+
+    // CAMetalLayer does not require attachment to a window; unattached layers
+    // provide drawables for headless/offscreen use (nextDrawable still works).
+    CAMetalLayer *layer = [CAMetalLayer layer];
+    REQUIRE(layer);
+
+    pl_swapchain sw = pl_metal_create_swapchain(metal, pl_metal_swapchain_params(
+        .layer = (__bridge void *) layer,
+    ));
+    REQUIRE(sw);
+
+    // Layer pointer must round-trip through the unwrap API
+    REQUIRE_CMP(pl_metal_swapchain_unwrap(sw), ==, (__bridge void *) layer, "p");
+
+    int w = 640, h = 480;
+    REQUIRE(pl_swapchain_resize(sw, &w, &h));
+
+    for (int i = 0; i < 10; i++) {
+        struct pl_swapchain_frame frame;
+        REQUIRE(pl_swapchain_start_frame(sw, &frame));
+        if (frame.fbo->params.blit_dst)
+            pl_tex_clear(gpu, frame.fbo, (float[4]){0});
+
+        struct pl_frame target;
+        pl_frame_from_swapchain(&target, &frame);
+
+        REQUIRE(pl_swapchain_submit_frame(sw));
+        pl_swapchain_swap_buffers(sw);
+
+        if (i == 5) {
+            w = 320;
+            h = 240;
+            REQUIRE(pl_swapchain_resize(sw, &w, &h));
+        }
+    }
+
+    pl_swapchain_destroy(&sw);
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        pl_log log = pl_test_logger();
+
+        // --- Default params ---
+        pl_metal metal = pl_metal_create(log, NULL);
+        if (!metal) {
+            pl_log_destroy(&log);
+            return SKIP;
+        }
+
+        // pl_metal_get must round-trip back to the same wrapper
+        REQUIRE_CMP(pl_metal_get(metal->gpu), ==, metal, "p");
+
+        gpu_shader_tests(metal->gpu);
+        metal_interop_tests(metal);
+        metal_swapchain_tests(metal);
+
+        pl_metal_destroy(&metal);
+
+        // --- External device + command queue injection ---
+        printf("Testing external device injection:\n");
+        id<MTLDevice> ext_device = MTLCreateSystemDefaultDevice();
+        REQUIRE(ext_device);
+        id<MTLCommandQueue> ext_queue = [ext_device newCommandQueue];
+        REQUIRE(ext_queue);
+
+        metal = pl_metal_create(log, pl_metal_params(
+            .device        = (__bridge void *) ext_device,
+            .command_queue = (__bridge void *) ext_queue,
+        ));
+        REQUIRE(metal);
+        gpu_shader_tests(metal->gpu);
+        pl_metal_destroy(&metal);
+
+        // --- no_compute variant ---
+        printf("Testing no_compute:\n");
+        metal = pl_metal_create(log, pl_metal_params(
+            .no_compute = true,
+        ));
+        REQUIRE(metal);
+        gpu_shader_tests(metal->gpu);
+        pl_metal_destroy(&metal);
+
+        pl_log_destroy(&log);
+    }
+
+    return 0;
+}
