diff --git a/src/metal/context.m b/src/metal/context.m
new file mode 100644
index 0000000..9452a37
--- /dev/null
+++ b/src/metal/context.m
@@ -0,0 +1,134 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+
+#import <Metal/Metal.h>
+
+const struct pl_metal_params pl_metal_default_params = { PL_METAL_DEFAULTS };
+
+static bool acquire_device(pl_log log,
+                           const struct pl_metal_params *params,
+                           id<MTLDevice> *out_device,
+                           id<MTLCommandQueue> *out_cmdqueue)
+{
+    id<MTLDevice> device = nil;
+    id<MTLCommandQueue> cmdQueue = nil;
+
+    if (params->device) {
+        device = (__bridge id<MTLDevice>) params->device;
+        if (!device) {
+            pl_fatal(log, "Supplied Metal device pointer is invalid");
+            return false;
+        }
+
+        if (params->command_queue) {
+            cmdQueue = (__bridge id<MTLCommandQueue>) params->command_queue;
+        } else {
+            cmdQueue = [device newCommandQueue];
+            if (!cmdQueue) {
+                pl_fatal(log, "Failed to create MTLCommandQueue for imported device");
+                return false;
+            }
+        }
+    } else {
+        device = MTLCreateSystemDefaultDevice();
+        if (!device) {
+            pl_fatal(log, "No Metal device available on this system");
+            return false;
+        }
+
+        cmdQueue = [device newCommandQueue];
+        if (!cmdQueue) {
+            pl_fatal(log, "Failed to create MTLCommandQueue");
+            return false;
+        }
+    }
+
+    *out_device = device;
+    *out_cmdqueue = cmdQueue;
+    return true;
+}
+
+static void log_device_info(pl_log log, id<MTLDevice> device)
+{
+    pl_info(log, "Metal device: %s", [[device name] UTF8String]);
+
+    if ([device supportsFamily:MTLGPUFamilyApple1])
+        pl_info(log, "    GPU family: Apple Silicon");
+    else if ([device supportsFamily:MTLGPUFamilyMac2])
+        pl_info(log, "    GPU family: Mac2");
+    else
+        pl_info(log, "    GPU family: Mac1 (legacy Intel)");
+
+    pl_info(log, "    Low-power: %s", device.isLowPower ? "yes" : "no");
+    pl_info(log, "    Headless: %s",  device.isHeadless ? "yes" : "no");
+    pl_info(log, "    Recommended working set: %zu MB",
+            (size_t)(device.recommendedMaxWorkingSetSize / (1024 * 1024)));
+}
+
+pl_metal pl_metal_create(pl_log log, const struct pl_metal_params *params)
+{
+    params = PL_DEF(params, &pl_metal_default_params);
+
+    struct pl_metal_t *metal = pl_zalloc_obj(NULL, metal, struct pl_metal_ctx);
+    struct pl_metal_ctx *ctx = PL_PRIV(metal);
+    ctx->log = log;
+    ctx->metal = metal;
+    ctx->device_imported = (params->device != NULL);
+
+    // Declare early for ARC: both are assigned via out-params before any goto.
+    id<MTLDevice> device = nil;
+    id<MTLCommandQueue> cmdQueue = nil;
+
+    if (!acquire_device(log, params, &device, &cmdQueue))
+        goto error;
+
+    log_device_info(log, device);
+
+    metal->device        = (void *) CFBridgingRetain(device);
+    metal->command_queue = (void *) CFBridgingRetain(cmdQueue);
+
+    metal->gpu = pl_gpu_create_metal(ctx, params);
+    if (!metal->gpu)
+        goto error;
+
+    return metal;
+
+error:
+    pl_metal_destroy((pl_metal *) &metal);
+    return NULL;
+}
+
+void pl_metal_destroy(pl_metal *ptr)
+{
+    pl_metal metal = *ptr;
+    if (!metal)
+        return;
+
+    struct pl_metal_t *p = (struct pl_metal_t *) metal;
+
+    // Destroy the GPU first, it may hold references to the command queue
+    pl_gpu_destroy(p->gpu);
+
+    if (p->command_queue)
+        CFBridgingRelease(p->command_queue);
+    if (p->device)
+        CFBridgingRelease(p->device);
+
+    pl_free_ptr((void **) ptr);
+}
