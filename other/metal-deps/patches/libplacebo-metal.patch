+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+#include "metal_ops.h"
+
+static MTLTextureDescriptor *make_tex_desc(const struct pl_tex_params *params,
+                                           bool host_visible)
+{
+    MTLPixelFormat mtlfmt = metal_plfmt(params->format);
+
+    MTLTextureDescriptor *desc = [MTLTextureDescriptor new];
+    desc.pixelFormat = mtlfmt;
+    desc.mipmapLevelCount = 1;
+    desc.storageMode = host_visible ? MTLStorageModeShared : MTLStorageModePrivate;
+
+    int dims = pl_tex_params_dimension(*params);
+    switch (dims) {
+    case 1:
+        desc.textureType = MTLTextureType1D;
+        desc.width  = params->w;
+        desc.height = 1;
+        desc.depth  = 1;
+        break;
+    case 2:
+        desc.textureType = MTLTextureType2D;
+        desc.width  = params->w;
+        desc.height = params->h;
+        desc.depth  = 1;
+        break;
+    case 3:
+        desc.textureType = MTLTextureType3D;
+        desc.width  = params->w;
+        desc.height = params->h;
+        desc.depth  = params->d;
+        break;
+    default:
+        return nil;
+    }
+
+    // MTLBlitCommandEncoder needs no usage flags to read/write any texture.
+    // ShaderRead is set for blit_src because compute-based blit emulation
+    // reads src via imageLoad (ShaderRead is required even for storable
+    // textures). ShaderWrite for blit_dst is covered by the storable flag,
+    // which pl_metal_tex_create promotes from blit_src/blit_dst (mirroring
+    // D3D11 FL11+ behaviour so pl_tex_blit_compute works correctly).
+    MTLTextureUsage usage = 0;
+    if (params->sampleable || params->blit_src)
+        usage |= MTLTextureUsageShaderRead;
+    if (params->storable)
+        usage |= MTLTextureUsageShaderWrite;
+    if (params->renderable)
+        usage |= MTLTextureUsageRenderTarget;
+    if (!usage)
+        usage = MTLTextureUsageShaderRead;
+
+    desc.usage = usage;
+    return desc;
+}
+
+static MTLRegion region_from_rc(const struct pl_rect3d *rc)
+{
+    return MTLRegionMake3D(rc->x0, rc->y0, rc->z0,
+                           rc->x1 - rc->x0,
+                           rc->y1 - rc->y0,
+                           rc->z1 - rc->z0);
+}
+
+pl_tex pl_metal_tex_create(pl_gpu gpu, const struct pl_tex_params *params)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+
+    struct pl_tex_t *tex = pl_zalloc_obj(NULL, tex, struct pl_tex_metal);
+    tex->params = *params;
+    tex->params.initial_data = NULL;
+    tex->sampler_type = PL_SAMPLER_NORMAL;
+
+    if (params->format->caps & PL_FMT_CAP_STORABLE)
+        tex->params.storable |= params->blit_src || params->blit_dst;
+    // Promote renderable for blit_dst so tex_clear_ex can use a render pass.
+    // SNORM formats lack PL_FMT_CAP_RENDERABLE and are never blit_dst targets.
+    tex->params.renderable |= params->blit_dst &&
+                              !!(params->format->caps & PL_FMT_CAP_RENDERABLE);
+    if ((params->format->caps & PL_FMT_CAP_LINEAR) && params->blit_src)
+        tex->params.sampleable = true;
+
+    struct pl_tex_metal *tex_p = PL_PRIV(tex);
+
+    bool host_accessible = params->host_readable || params->host_writable;
+    tex_p->host_visible = host_accessible;
+
+    // Declare early for ARC
+    id<MTLTexture> mtl_tex = nil;
+
+    MTLTextureDescriptor *desc = make_tex_desc(&tex->params, host_accessible);
+    if (!desc) {
+        PL_ERR(gpu, "Unsupported texture dimension");
+        goto error;
+    }
+
+    mtl_tex = [device newTextureWithDescriptor:desc];
+    if (!mtl_tex) {
+        PL_ERR(gpu, "Failed to create MTLTexture (%dx%dx%d, fmt=%u)",
+               params->w, params->h, params->d,
+               (unsigned) metal_plfmt(params->format));
+        goto error;
+    }
+
+    tex_p->tex = (void *) CFBridgingRetain(mtl_tex);
+
+    if (params->initial_data) {
+        // For 1D textures h==0 and for 1D/2D textures d==0; the rc and
+        // pitches must use 1 as the minimum so pl_tex_transfer_size doesn't
+        // compute a zero (or negative) length and so the region covers the
+        // full texture.
+        int h = PL_DEF(params->h, 1);
+        int d = PL_DEF(params->d, 1);
+        struct pl_tex_transfer_params ul = {
+            .tex = tex,
+            .ptr = (void *) params->initial_data,
+            .rc  = { 0, 0, 0, params->w, h, d },
+            .row_pitch   = params->w * params->format->texel_size,
+            .depth_pitch = params->w * h * params->format->texel_size,
+        };
+        if (!pl_metal_tex_upload(gpu, &ul))
+            goto error;
+    }
+
+    return tex;
+
+error:
+    pl_metal_tex_destroy(gpu, tex);
+    return NULL;
+}
+
+void pl_metal_tex_destroy(pl_gpu gpu, pl_tex tex)
+{
+    struct pl_tex_metal *tex_p = PL_PRIV(tex);
+    (void) gpu;
+
+    if (tex_p->tex)
+        CFBridgingRelease(tex_p->tex);
+
+    pl_free((void *) tex);
+}
+
+void pl_metal_tex_invalidate(pl_gpu gpu, pl_tex tex)
+{
+    // Metal automatically invalidates transient resources; no-op here.
+    (void) gpu;
+    (void) tex;
+}
+
+void pl_metal_tex_clear_ex(pl_gpu gpu, pl_tex tex,
+                           const union pl_clear_color color)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    struct pl_tex_metal *tex_p = PL_PRIV(tex);
+    id<MTLTexture> mtl_tex = (__bridge id<MTLTexture>) tex_p->tex;
+
+    pl_assert(tex->params.renderable);
+
+    id<MTLCommandBuffer> cmd = metal_cmd_get(p);
+
+    MTLClearColor clr;
+    switch (tex->params.format->type) {
+    case PL_FMT_UINT:
+        clr = MTLClearColorMake(color.u[0], color.u[1], color.u[2], color.u[3]);
+        break;
+    case PL_FMT_SINT:
+        clr = MTLClearColorMake(color.i[0], color.i[1], color.i[2], color.i[3]);
+        break;
+    default:
+        clr = MTLClearColorMake(color.f[0], color.f[1], color.f[2], color.f[3]);
+        break;
+    }
+
+    MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture     = mtl_tex;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionClear;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    rp.colorAttachments[0].clearColor  = clr;
+
+    id<MTLRenderCommandEncoder> enc =
+        [cmd renderCommandEncoderWithDescriptor:rp];
+    [enc endEncoding]; // empty pass = clear
+}
+
+void pl_metal_tex_blit(pl_gpu gpu, const struct pl_tex_blit_params *params)
+{
+    if (pl_tex_blit_compute(gpu, params))
+        return;
+
+    // If the blit doesn't require flipping, scaling, or format conversion,
+    // use the blit encoder's native copy (handles integer and 1D/3D formats
+    // that pl_tex_blit_raster rejects).
+    pl_rect3d src_norm = params->src_rc;
+    pl_rect3d dst_norm = params->dst_rc;
+    pl_rect3d_normalize(&src_norm);
+    pl_rect3d_normalize(&dst_norm);
+
+    bool same_region = pl_rect3d_eq(src_norm, dst_norm);
+    bool same_fmt    = params->src->params.format == params->dst->params.format;
+
+    if (same_region && same_fmt) {
+        struct pl_gpu_metal *p = PL_PRIV(gpu);
+        struct pl_tex_metal *src_p = PL_PRIV(params->src);
+        struct pl_tex_metal *dst_p = PL_PRIV(params->dst);
+        id<MTLTexture> src_tex = (__bridge id<MTLTexture>) src_p->tex;
+        id<MTLTexture> dst_tex = (__bridge id<MTLTexture>) dst_p->tex;
+
+        MTLOrigin origin = MTLOriginMake(src_norm.x0, src_norm.y0, src_norm.z0);
+        MTLSize size = MTLSizeMake(pl_rect_w(src_norm),
+                                   PL_DEF(pl_rect_h(src_norm), 1),
+                                   PL_DEF(pl_rect_d(src_norm), 1));
+
+        id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+        [blit copyFromTexture:src_tex
+                 sourceSlice:0
+                 sourceLevel:0
+                sourceOrigin:origin
+                  sourceSize:size
+                   toTexture:dst_tex
+            destinationSlice:0
+            destinationLevel:0
+           destinationOrigin:origin];
+        return;
+    }
+
+    // Scaled blits: only 2D non-integer formats are supported via raster.
+    pl_tex_blit_raster(gpu, params);
+}
+
+bool pl_metal_tex_upload(pl_gpu gpu, const struct pl_tex_transfer_params *params)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    struct pl_tex_metal *tex_p = PL_PRIV(params->tex);
+    id<MTLTexture> mtl_tex = (__bridge id<MTLTexture>) tex_p->tex;
+
+    MTLRegion region = region_from_rc(&params->rc);
+    NSUInteger bytes_per_row   = params->row_pitch;
+    NSUInteger bytes_per_image = params->depth_pitch;
+
+    if (params->buf) {
+        struct pl_buf_metal *buf_p = PL_PRIV(params->buf);
+        id<MTLBuffer> mtl_buf = (__bridge id<MTLBuffer>) buf_p->buf;
+
+        id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+        [blit copyFromBuffer:mtl_buf
+                sourceOffset:params->buf_offset
+           sourceBytesPerRow:bytes_per_row
+         sourceBytesPerImage:bytes_per_image
+                  sourceSize:region.size
+                   toTexture:mtl_tex
+            destinationSlice:0
+            destinationLevel:0
+           destinationOrigin:region.origin];
+        return true;
+    }
+
+    if (!params->ptr)
+        return false;
+
+    if (tex_p->host_visible) {
+        [mtl_tex replaceRegion:region
+                   mipmapLevel:0
+                         slice:0
+                     withBytes:params->ptr
+                   bytesPerRow:bytes_per_row
+                 bytesPerImage:bytes_per_image];
+        return true;
+    }
+
+    // Private texture: upload via a temporary Shared staging buffer.
+    // newBufferWithBytes:length:options: copies params->ptr into the MTLBuffer
+    // immediately, so the caller's host pointer is safe to reuse on return.
+    // The staging buffer itself is released asynchronously once the GPU blit
+    // completes, keeping this call non-blocking.
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+    size_t total = pl_tex_transfer_size(params);
+
+    id<MTLBuffer> staging = [device newBufferWithBytes:params->ptr
+                                               length:total
+                                              options:MTLResourceStorageModeShared];
+    if (!staging) {
+        PL_ERR(gpu, "Failed to allocate staging buffer for tex_upload");
+        return false;
+    }
+
+    id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+    [blit copyFromBuffer:staging
+            sourceOffset:0
+       sourceBytesPerRow:bytes_per_row
+     sourceBytesPerImage:bytes_per_image
+              sourceSize:region.size
+               toTexture:mtl_tex
+        destinationSlice:0
+        destinationLevel:0
+       destinationOrigin:region.origin];
+
+    metal_cmd_submit_with_staging(p, staging);
+    return true;
+}
+
+bool pl_metal_tex_download(pl_gpu gpu, const struct pl_tex_transfer_params *params)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    struct pl_tex_metal *tex_p = PL_PRIV(params->tex);
+    id<MTLTexture> mtl_tex = (__bridge id<MTLTexture>) tex_p->tex;
+
+    MTLRegion region = region_from_rc(&params->rc);
+    NSUInteger bytes_per_row   = params->row_pitch;
+    NSUInteger bytes_per_image = params->depth_pitch;
+
+    if (params->buf) {
+        struct pl_buf_metal *buf_p = PL_PRIV(params->buf);
+        id<MTLBuffer> mtl_buf = (__bridge id<MTLBuffer>) buf_p->buf;
+
+        id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+        [blit copyFromTexture:mtl_tex
+                  sourceSlice:0
+                  sourceLevel:0
+                 sourceOrigin:region.origin
+                   sourceSize:region.size
+                     toBuffer:mtl_buf
+            destinationOffset:params->buf_offset
+       destinationBytesPerRow:bytes_per_row
+     destinationBytesPerImage:bytes_per_image];
+        return true;
+    }
+
+    if (!params->ptr)
+        return false;
+
+    // Ensure any pending GPU writes to the texture are done.
+    metal_cmd_submit(p, true);
+
+    if (tex_p->host_visible) {
+        [mtl_tex getBytes:params->ptr
+              bytesPerRow:bytes_per_row
+            bytesPerImage:bytes_per_image
+               fromRegion:region
+              mipmapLevel:0
+                    slice:0];
+        return true;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>) p->ctx->metal->device;
+    size_t total = pl_tex_transfer_size(params);
+
+    id<MTLBuffer> staging = [device newBufferWithLength:total
+                                               options:MTLResourceStorageModeShared];
+    if (!staging) {
+        PL_ERR(gpu, "Failed to allocate staging buffer for tex_download");
+        return false;
+    }
+
+    id<MTLBlitCommandEncoder> blit = metal_blit_enc_get(p);
+    [blit copyFromTexture:mtl_tex
+              sourceSlice:0
+              sourceLevel:0
+             sourceOrigin:region.origin
+               sourceSize:region.size
+                 toBuffer:staging
+        destinationOffset:0
+   destinationBytesPerRow:bytes_per_row
+ destinationBytesPerImage:bytes_per_image];
+    metal_cmd_submit(p, true);
+
+    memcpy(params->ptr, staging.contents, total);
+    return true;
+}
+
+bool pl_metal_tex_poll(pl_gpu gpu, pl_tex tex, uint64_t timeout)
+{
+    // All GPU work is either already committed synchronously or will be drained
+    // by the next gpu_finish; textures are always ready from the CPU's view.
+    (void) gpu;
+    (void) tex;
+    (void) timeout;
+    return true;
+}
+
+pl_tex pl_metal_wrap(pl_gpu gpu, const struct pl_metal_wrap_params *params)
+{
+    if (!params->texture) {
+        PL_ERR(gpu, "pl_metal_wrap: texture handle is NULL");
+        return NULL;
+    }
+
+    id<MTLTexture> mtl_tex = (__bridge id<MTLTexture>) params->texture;
+
+    if (mtl_tex.mipmapLevelCount != 1) {
+        PL_ERR(gpu, "pl_metal_wrap: mipmapped textures not supported "
+               "(%lu mip levels)", (unsigned long) mtl_tex.mipmapLevelCount);
+        return NULL;
+    }
+    if (mtl_tex.sampleCount != 1) {
+        PL_ERR(gpu, "pl_metal_wrap: multisampled textures not supported "
+               "(%lu samples)", (unsigned long) mtl_tex.sampleCount);
+        return NULL;
+    }
+
+    struct pl_tex_t *tex = pl_zalloc_obj(NULL, tex, struct pl_tex_metal);
+    tex->sampler_type = PL_SAMPLER_NORMAL;
+
+    struct pl_tex_metal *tex_p = PL_PRIV(tex);
+    tex_p->imported = true;
+    // Wrapped textures are never modified via replaceRegion; treat as non-host-visible.
+    tex_p->host_visible = false;
+    tex_p->tex = (void *) CFBridgingRetain(mtl_tex);
+
+    tex->params.w = (int) mtl_tex.width;
+    tex->params.h = (int) mtl_tex.height;
+    tex->params.d = (int) (mtl_tex.textureType == MTLTextureType3D
+                            ? mtl_tex.depth : 0);
+
+    MTLTextureUsage usage = mtl_tex.usage;
+    tex->params.sampleable  = !!(usage & MTLTextureUsageShaderRead);
+    tex->params.storable    = !!(usage & MTLTextureUsageShaderWrite);
+    tex->params.renderable  = !!(usage & MTLTextureUsageRenderTarget);
+    // Metal blit encoder can read/write any texture regardless of usage flags.
+    tex->params.blit_src = true;
+    tex->params.blit_dst = true;
+
+    MTLPixelFormat pf = mtl_tex.pixelFormat;
+    for (int i = 0; i < gpu->num_formats; i++) {
+        if (metal_plfmt(gpu->formats[i]) == pf) {
+            tex->params.format = gpu->formats[i];
+            break;
+        }
+    }
+
+    if (!tex->params.format) {
+        PL_ERR(gpu, "pl_metal_wrap: no matching pl_fmt for MTLPixelFormat %u",
+               (unsigned) pf);
+        pl_metal_tex_destroy(gpu, tex);
+        return NULL;
+    }
+
+    if (params->user_data)
+        tex->params.user_data = params->user_data;
+    if (params->debug_tag)
+        tex->params.debug_tag = params->debug_tag;
+
+    return tex;
+}
+
+void *pl_metal_unwrap(pl_gpu gpu, pl_tex tex)
+{
+    struct pl_tex_metal *tex_p = PL_PRIV(tex);
+    (void) gpu;
+    // Return the raw Objective-C object pointer (not a retained reference).
+    return (__bridge void *)((__bridge id<MTLTexture>) tex_p->tex);
+}
diff --git a/src/metal/meson.build b/src/metal/meson.build
new file mode 100644
index 0000000..3aad3fd
--- /dev/null
+++ b/src/metal/meson.build
@@ -0,0 +1,60 @@
+metal = get_option('metal')
+metal_frameworks = disabler()
+
+metal = metal.require(host_machine.system() == 'darwin',
+  error_message: 'Metal is only supported on macOS.')
+
+if metal.allowed()
+  objc = add_languages('objc', required: metal, native: false)
+  metal = metal.require(objc,
+    error_message: 'An Objective-C compiler is required for Metal support.')
+
+  metal_frameworks = dependency('appleframeworks',
+    modules: ['Foundation', 'Metal', 'QuartzCore', 'CoreGraphics'],
+    required: metal,
+  )
+  metal = metal.require(metal_frameworks.found())
+endif
+
+metal_spirv_cross = dependency('spirv-cross-c', required: metal)
+metal = metal.require(metal_spirv_cross.found())
+components.set('metal', metal.allowed())
+
+# spirv-cross-c.pc only declares -lspirv-cross-c but its static archive requires
+# the full C++ set of spirv-cross sub-libraries as transitive dependencies.
+# Probe for them individually so that the linker sees the complete closure.
+_spvc_extra = []
+if metal.allowed()
+foreach _lib : ['spirv-cross-msl', 'spirv-cross-hlsl', 'spirv-cross-glsl',
+                 'spirv-cross-core', 'spirv-cross-cpp',
+                 'spirv-cross-reflect', 'spirv-cross-util']
+  _found = cc.find_library(_lib, dirs: metal_spirv_cross.get_variable(pkgconfig: 'libdir'), required: metal)
+  if _found.found()
+    _spvc_extra += [_found]
+  endif
+endforeach
+endif
+
+if metal.allowed()
+  # ARC is needed for correct ObjC memory management in the Metal backend.
+  add_project_arguments(['-fobjc-arc'], language: 'objc')
+
+
+  build_deps += declare_dependency(
+    dependencies: [metal_frameworks, metal_spirv_cross] + _spvc_extra
+  )
+
+  sources += [
+    'metal/context.m',
+    'metal/formats.m',
+    'metal/gpu.m',
+    'metal/gpu_buf.m',
+    'metal/gpu_pass.m',
+    'metal/gpu_tex.m',
+    'metal/swapchain.m',
+  ]
+
+  tests += 'metal.m'
+else
+  sources += 'metal/stubs.c'
+endif
