new file mode 100644
index 0000000..fa98652
--- /dev/null
+++ b/src/metal/gpu.h
@@ -0,0 +1,153 @@
+/*
+ * This file is part of libplacebo.
+ *
+ * libplacebo is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * libplacebo is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include "../gpu.h"
+#include "../glsl/spirv.h"
+
+#include <libplacebo/gpu.h>
+#include <libplacebo/metal.h>
+
+// Context shared between context.m and gpu.m. Appended after pl_metal_t in
+// the same allocation (PL_PRIV pattern).
+struct pl_metal_ctx {
+    pl_log log;
+    pl_metal metal;       // back-reference to the public wrapper struct
+    bool device_imported; // true if device/queue were supplied by the caller
+    bool failed;
+};
+
+// Metal buffer slot reserved for push constants (above any normal descriptor).
+#define METAL_PUSH_CONST_BUF_IDX 29u
+
+// Number of timer query slots in the ring buffer.
+#define METAL_TIMER_SLOTS 16
+
+// Maximum number of frames the GPU pipeline can have in flight simultaneously.
+// Matches CAMetalLayer.maximumDrawableCount's maximum (2–3). Push-constant
+// buffers and the vertex buffer each have this many ring slots so consecutive
+// frames can be encoded by the CPU while earlier frames are still on the GPU.
+#define METAL_MAX_IN_FLIGHT 3
+
+// sample_buf holds 2*METAL_TIMER_SLOTS counter samples: [start, end] per slot.
+struct pl_timer_t {
+    int  current;    // ring-buffer write head (next slot to fill)
+    int  pending;    // number of submitted-but-unread slots
+    void *sample_buf; // id<MTLCounterSampleBuffer> (CFBridgingRetain'd); NULL when unsupported
+};
+
+// Private GPU state. Allocated as the priv area of pl_gpu_t by pl_gpu_create_metal.
+struct pl_gpu_metal {
+    struct pl_gpu_fns impl; // must be first, this is PL_PRIV(gpu)
+    struct pl_metal_ctx *ctx;
+
+    pl_spirv spirv; // GLSL -> SPIR-V compiler
+
+    // Command buffer state, held open across multiple GPU operations and
+    // committed by gpu_flush / gpu_finish, or implicitly when switching
+    // encoder types.  All stored as void * (CFBridgingRetain'd).
+    void *cmd_buf;   // id<MTLCommandBuffer>, NULL when idle
+    void *blit_enc;  // id<MTLBlitCommandEncoder>, NULL when not blitting
+
+    // Sampler cache: one MTLSamplerState per (sample_mode, address_mode) pair.
+    void *samplers[PL_TEX_SAMPLE_MODE_COUNT][PL_TEX_ADDRESS_MODE_COUNT];
+
+    // Per-frame ring of Shared vertex buffers for large inline vertex data.
+    // Index by frame_index; avoids CPU/GPU races when multiple frames are in flight.
+    void *vtx_bufs[METAL_MAX_IN_FLIGHT];
+    size_t vtx_buf_size; // capacity of each slot (all slots share the same size)
+
+    // Per-frame ring of Shared index buffers for inline index data.
+    // Same ring pattern as vtx_bufs, avoids allocating a new MTLBuffer per draw.
+    void *idx_bufs[METAL_MAX_IN_FLIGHT];
+    size_t idx_buf_size; // capacity of each slot
+
+    // Current frame slot in [0, METAL_MAX_IN_FLIGHT).
+    // Advanced by the swapchain in submit_frame; read by pass_run to pick the
+    // correct per-frame ring slot for push-constant and vertex buffers.
+    uint32_t frame_index;
+
+    // GPU timestamp counter support (macOS 11+, MTLCounterSamplingPointAtStageBoundary).
+    bool has_gpu_timer;
+    void *timestamp_counter_set; // id<MTLCounterSet> (CFBridgingRetain'd); NULL when unsupported
+};
+
+// Private buffer state (appended after pl_buf_t via pl_zalloc_obj).
+struct pl_buf_metal {
+    void *buf;          // id<MTLBuffer>  (CFBridgingRetain'd)
+    bool host_visible;  // true -> MTLStorageModeShared; CPU can read/write .contents
+};
+
+// Private texture state (appended after pl_tex_t via pl_zalloc_obj).
+struct pl_tex_metal {
+    void *tex;          // id<MTLTexture> (CFBridgingRetain'd)
+    bool host_visible;  // true -> MTLStorageModeShared; CPU can replaceRegion/getBytes
+    bool imported;      // true if wrapped from an external MTLTexture
+};
+
+// Private pass state (appended after pl_pass_t via pl_zalloc_obj).
+struct pl_pass_metal {
+    bool is_compute;
+    void *pso;         // id<MTLComputePipelineState> or id<MTLRenderPipelineState>
+    // Per-frame ring of push-constant buffers (host-visible Shared MTLBuffers).
+    // NULL when push_constants_size == 0.  Index by pl_gpu_metal.frame_index.
+    void *pushc_bufs[METAL_MAX_IN_FLIGHT];
+    uint32_t pushc_slot; // Metal buffer index for push constants in MSL
+    uint32_t local_size[3]; // threadgroup size from local_size declaration
+};
+
+pl_gpu pl_gpu_create_metal(struct pl_metal_ctx *ctx,
+                           const struct pl_metal_params *params);
+
+void pl_metal_setup_formats(struct pl_gpu_t *gpu);
+
+pl_tex pl_metal_tex_create(pl_gpu gpu, const struct pl_tex_params *params);
+void   pl_metal_tex_destroy(pl_gpu gpu, pl_tex tex);
+void   pl_metal_tex_invalidate(pl_gpu gpu, pl_tex tex);
+void   pl_metal_tex_clear_ex(pl_gpu gpu, pl_tex tex,
+                             const union pl_clear_color color);
+void   pl_metal_tex_blit(pl_gpu gpu, const struct pl_tex_blit_params *params);
+bool   pl_metal_tex_upload(pl_gpu gpu,
+                           const struct pl_tex_transfer_params *params);
+bool   pl_metal_tex_download(pl_gpu gpu,
+                             const struct pl_tex_transfer_params *params);
+bool   pl_metal_tex_poll(pl_gpu gpu, pl_tex tex, uint64_t timeout);
+
+pl_buf pl_metal_buf_create(pl_gpu gpu, const struct pl_buf_params *params);
+void   pl_metal_buf_destroy(pl_gpu gpu, pl_buf buf);
+void   pl_metal_buf_write(pl_gpu gpu, pl_buf buf, size_t offset,
+                          const void *data, size_t size);
+bool   pl_metal_buf_read(pl_gpu gpu, pl_buf buf, size_t offset,
+                         void *dest, size_t size);
+void   pl_metal_buf_copy(pl_gpu gpu, pl_buf dst, size_t dst_offset,
+                         pl_buf src, size_t src_offset, size_t size);
+
+int     pl_metal_desc_namespace(pl_gpu gpu, enum pl_desc_type type);
+pl_pass pl_metal_pass_create(pl_gpu gpu, const struct pl_pass_params *params);
+void    pl_metal_pass_destroy(pl_gpu gpu, pl_pass pass);
+void    pl_metal_pass_run(pl_gpu gpu, const struct pl_pass_run_params *params);
+
+pl_timer  pl_metal_timer_create(pl_gpu gpu);
+void      pl_metal_timer_destroy(pl_gpu gpu, pl_timer timer);
+uint64_t  pl_metal_timer_query(pl_gpu gpu, pl_timer timer);
+void pl_metal_timer_start(pl_timer timer, void *encoder_opaque);
+void pl_metal_timer_end(pl_timer timer, void *encoder_opaque);
+
+void pl_metal_gpu_flush(pl_gpu gpu);
+void pl_metal_gpu_finish(pl_gpu gpu);
+bool pl_metal_gpu_is_failed(pl_gpu gpu);
