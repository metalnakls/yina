+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with libplacebo. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "gpu.h"
+
+#import <Metal/Metal.h>
+
+#define C_SAMPLE   PL_FMT_CAP_SAMPLEABLE
+#define C_LINEAR   PL_FMT_CAP_LINEAR
+#define C_RENDER   PL_FMT_CAP_RENDERABLE
+#define C_BLEND    PL_FMT_CAP_BLENDABLE
+#define C_STORE    PL_FMT_CAP_STORABLE
+#define C_HREAD    PL_FMT_CAP_HOST_READABLE
+#define C_VERTEX   PL_FMT_CAP_VERTEX
+
+#define CAPS_UNORM  (C_SAMPLE | C_LINEAR | C_RENDER | C_BLEND | C_VERTEX | C_HREAD)
+#define CAPS_SNORM  (C_SAMPLE | C_LINEAR | C_VERTEX | C_HREAD)
+#define CAPS_HALF   (C_SAMPLE | C_LINEAR | C_RENDER | C_BLEND | C_VERTEX | C_HREAD)
+#define CAPS_FLOAT  (C_SAMPLE | C_LINEAR | C_RENDER | C_BLEND | C_VERTEX | C_HREAD)
+#define CAPS_UINT   (C_SAMPLE           | C_RENDER           | C_VERTEX | C_HREAD)
+#define CAPS_SINT   (C_SAMPLE           | C_RENDER           | C_VERTEX | C_HREAD)
+
+struct metal_format_entry {
+    MTLPixelFormat  mtlfmt;
+    bool            storable;     // compute write supported on all Mac GPUs
+    bool            vertex_only;  // no pixel format; vertex attribute use only
+    struct pl_fmt_t fmt;
+};
+
+#define IDX(...) {__VA_ARGS__}
+#define BITS(...) {__VA_ARGS__}
+
+#define FMT(_name, _mtlfmt, _type, _num, _sz, _bits, _order, _caps, _store) \
+    {                                                                       \
+        .mtlfmt   = MTLPixelFormat##_mtlfmt,                                \
+        .storable = _store,                                                 \
+        .fmt = {                                                            \
+            .name            = _name,                                       \
+            .type            = PL_FMT_##_type,                              \
+            .num_components  = _num,                                        \
+            .texel_size      = _sz,                                         \
+            .texel_align     = 1,                                           \
+            .internal_size   = _sz,                                         \
+            .component_depth = _bits,                                       \
+            .host_bits       = _bits,                                       \
+            .sample_order    = _order,                                      \
+            .caps            = _caps,                                       \
+        },                                                                  \
+    }
+
+#define REGFMT(_name, _mtlfmt, _type, _num, _bits, _caps, _store)           \
+    FMT(_name, _mtlfmt, _type, _num, ((_num) * (_bits) / 8),                \
+        BITS(_bits, _bits, _bits, _bits), IDX(0, 1, 2, 3), _caps, _store)
+
+// Vertex-only format: no MTLPixelFormat exists; used only by pl_find_vertex_fmt.
+// gpu_pass.m translates these to MTLVertexFormat when building pipeline descriptors.
+#define VTXFMT(_name, _type, _num, _bits)                               \
+    {                                                                   \
+        .mtlfmt      = MTLPixelFormatInvalid,                           \
+        .vertex_only = true,                                            \
+        .fmt = {                                                        \
+            .name            = _name,                                   \
+            .type            = PL_FMT_##_type,                          \
+            .num_components  = _num,                                    \
+            .texel_size      = ((_num) * (_bits) / 8),                  \
+            .texel_align     = (_bits) / 8,                             \
+            .internal_size   = ((_num) * (_bits) / 8),                  \
+            .component_depth = BITS(_bits, _bits, _bits, _bits),        \
+            .host_bits       = BITS(_bits, _bits, _bits, _bits),        \
+            .sample_order    = IDX(0, 1, 2, 3),                        \
+            .caps            = PL_FMT_CAP_VERTEX,                      \
+        },                                                              \
+    }
+
+static const struct metal_format_entry metal_formats[] = {
+    REGFMT("r8",       R8Unorm,    UNORM, 1,  8, CAPS_UNORM, true),
+    REGFMT("rg8",      RG8Unorm,   UNORM, 2,  8, CAPS_UNORM, true),
+    REGFMT("rgba8",    RGBA8Unorm, UNORM, 4,  8, CAPS_UNORM, true),
+    REGFMT("r16",      R16Unorm,   UNORM, 1, 16, CAPS_UNORM, true),
+    REGFMT("rg16",     RG16Unorm,  UNORM, 2, 16, CAPS_UNORM, true),
+    REGFMT("rgba16",   RGBA16Unorm,UNORM, 4, 16, CAPS_UNORM, true),
+
+    REGFMT("r8s",      R8Snorm,    SNORM, 1,  8, CAPS_SNORM, false),
+    REGFMT("rg8s",     RG8Snorm,   SNORM, 2,  8, CAPS_SNORM, false),
+    REGFMT("rgba8s",   RGBA8Snorm, SNORM, 4,  8, CAPS_SNORM, false),
+    REGFMT("r16s",     R16Snorm,   SNORM, 1, 16, CAPS_SNORM, false),
+    REGFMT("rg16s",    RG16Snorm,  SNORM, 2, 16, CAPS_SNORM, false),
+    REGFMT("rgba16s",  RGBA16Snorm,SNORM, 4, 16, CAPS_SNORM, false),
+
+    REGFMT("r16hf",    R16Float,   FLOAT, 1, 16, CAPS_HALF,  true),
+    REGFMT("rg16hf",   RG16Float,  FLOAT, 2, 16, CAPS_HALF,  true),
+    REGFMT("rgba16hf", RGBA16Float,FLOAT, 4, 16, CAPS_HALF,  true),
+
+    REGFMT("r32f",     R32Float,   FLOAT, 1, 32, CAPS_FLOAT, true),
+    REGFMT("rg32f",    RG32Float,  FLOAT, 2, 32, CAPS_FLOAT, true),
+    REGFMT("rgba32f",  RGBA32Float,FLOAT, 4, 32, CAPS_FLOAT, true),
+
+    REGFMT("r8u",      R8Uint,     UINT,  1,  8, CAPS_UINT,  true),
+    REGFMT("rg8u",     RG8Uint,    UINT,  2,  8, CAPS_UINT,  true),
+    REGFMT("rgba8u",   RGBA8Uint,  UINT,  4,  8, CAPS_UINT,  true),
+    REGFMT("r16u",     R16Uint,    UINT,  1, 16, CAPS_UINT,  true),
+    REGFMT("rg16u",    RG16Uint,   UINT,  2, 16, CAPS_UINT,  true),
+    REGFMT("rgba16u",  RGBA16Uint, UINT,  4, 16, CAPS_UINT,  true),
+    REGFMT("r32u",     R32Uint,    UINT,  1, 32, CAPS_UINT,  true),
+    REGFMT("rg32u",    RG32Uint,   UINT,  2, 32, CAPS_UINT,  true),
+    REGFMT("rgba32u",  RGBA32Uint, UINT,  4, 32, CAPS_UINT,  true),
+
+    REGFMT("r8i",      R8Sint,     SINT,  1,  8, CAPS_SINT,  true),
+    REGFMT("rg8i",     RG8Sint,    SINT,  2,  8, CAPS_SINT,  true),
+    REGFMT("rgba8i",   RGBA8Sint,  SINT,  4,  8, CAPS_SINT,  true),
+    REGFMT("r16i",     R16Sint,    SINT,  1, 16, CAPS_SINT,  true),
+    REGFMT("rg16i",    RG16Sint,   SINT,  2, 16, CAPS_SINT,  true),
+    REGFMT("rgba16i",  RGBA16Sint, SINT,  4, 16, CAPS_SINT,  true),
+    REGFMT("r32i",     R32Sint,    SINT,  1, 32, CAPS_SINT,  true),
+    REGFMT("rg32i",    RG32Sint,   SINT,  2, 32, CAPS_SINT,  true),
+    REGFMT("rgba32i",  RGBA32Sint, SINT,  4, 32, CAPS_SINT,  true),
+
+    // bgra8: standard SDR swapchain format, renderable but not storable
+    FMT("bgra8",    BGRA8Unorm,  UNORM, 4, 4,
+        BITS(8, 8, 8, 8), IDX(2, 1, 0, 3),
+        CAPS_UNORM, false),
+
+    // bgra10xr: Display P3 extended-range format used for EDR/HDR swapchains.
+    // Renderable and blendable, but not compute-storable.
+    // Available on macOS 10.12+ with CAMetalLayer EDR mode.
+    FMT("bgra10xr", BGRA10_XR,  UNORM, 4, 8,
+        BITS(10, 10, 10, 10), IDX(2, 1, 0, 3),
+        C_SAMPLE | C_LINEAR | C_RENDER | C_BLEND, false),
+
+    FMT("rgb10a2",  RGB10A2Unorm, UNORM, 4, 4,
+        BITS(10, 10, 10, 2), IDX(0, 1, 2, 3),
+        CAPS_UNORM, false),
+
+    FMT("rgb10a2u", RGB10A2Uint,  UINT,  4, 4,
+        BITS(10, 10, 10, 2), IDX(0, 1, 2, 3),
+        CAPS_UINT, false),
+
+    FMT("rg11b10f", RG11B10Float, FLOAT, 3, 4,
+        BITS(11, 11, 10, 0), IDX(0, 1, 2, 0),
+        C_SAMPLE | C_LINEAR | C_RENDER | C_HREAD, false),
+
+    // ── Vertex-only ──────────────────────────────────────────────────────────
+    // Metal has no RGB32Float pixel format, but MTLVertexFormatFloat3 is valid.
+    VTXFMT("rgb32f", FLOAT, 3, 32),
+
+    {0}
+};
+
+#undef BITS
+#undef IDX
+#undef REGFMT
+#undef VTXFMT
+#undef FMT
+
+void pl_metal_setup_formats(struct pl_gpu_t *gpu)
+{
+    PL_ARRAY(pl_fmt) formats = {0};
+
+    // Sentinel is fmt.name == NULL, not mtlfmt == 0, because vertex-only entries
+    // have mtlfmt = MTLPixelFormatInvalid (0) but are still valid table entries.
+    for (size_t i = 0; metal_formats[i].fmt.name; i++) {
+        const struct metal_format_entry *e = &metal_formats[i];
+
+        struct pl_fmt_t *fmt = pl_alloc_obj(gpu, fmt, MTLPixelFormat);
+        MTLPixelFormat *fmtp = PL_PRIV(fmt);
+        *fmt  = e->fmt;
+        *fmtp = e->mtlfmt;
+
+        for (int j = fmt->num_components; j < 4; j++) {
+            fmt->component_depth[j] = 0;
+            fmt->host_bits[j]       = 0;
+            fmt->sample_order[j]    = 0;
+        }
+
+        if (e->vertex_only) {
+            // No pixel format: derive a stable signature from the name so the
+            // dispatch cache never confuses this entry with a real pixel format.
+            // High bit set guarantees no collision with any MTLPixelFormat value.
+            uint64_t h = 5381;
+            for (const char *c = fmt->name; *c; c++)
+                h = h * 33 + (unsigned char)*c;
+            fmt->signature = h | 0x8000000000000000ULL;
+
+            fmt->glsl_type = pl_var_glsl_type_name(pl_var_from_fmt(fmt, ""));
+            pl_assert(fmt->glsl_type);
+            PL_ARRAY_APPEND(gpu, formats, fmt);
+            continue;
+        }
+
+        fmt->signature = (uint64_t) e->mtlfmt;
+
+        // STORABLE requires compute; READWRITE implies STORABLE.
+        if (e->storable && gpu->glsl.compute) {
+            fmt->caps |= PL_FMT_CAP_STORABLE | PL_FMT_CAP_READWRITE;
+        } else {
+            fmt->caps &= ~(PL_FMT_CAP_STORABLE | PL_FMT_CAP_READWRITE);
+        }
+
+        // BLITTABLE via compute (if storable) or via a raster pass
+        // (if renderable + sampleable), analog to the D3D11 logic.
+        if (fmt->caps & PL_FMT_CAP_STORABLE) {
+            fmt->caps |= PL_FMT_CAP_BLITTABLE;
+        } else {
+            static const enum pl_fmt_caps req = PL_FMT_CAP_RENDERABLE |
+                                                PL_FMT_CAP_SAMPLEABLE;
+            if ((fmt->caps & req) == req)
+                fmt->caps |= PL_FMT_CAP_BLITTABLE;
+        }
+
+        if (fmt->caps & (PL_FMT_CAP_VERTEX | PL_FMT_CAP_TEXEL_UNIFORM |
+                                             PL_FMT_CAP_TEXEL_STORAGE)) {
+            fmt->glsl_type = pl_var_glsl_type_name(pl_var_from_fmt(fmt, ""));
+            pl_assert(fmt->glsl_type);
+        }
+
+        if (fmt->caps & (PL_FMT_CAP_STORABLE | PL_FMT_CAP_TEXEL_STORAGE))
+            fmt->glsl_format = pl_fmt_glsl_format(fmt, fmt->num_components);
+
+        if (fmt->caps & PL_FMT_CAP_SAMPLEABLE)
+            fmt->gatherable = true;
+
+        fmt->fourcc = pl_fmt_fourcc(fmt);
+
+        PL_ARRAY_APPEND(gpu, formats, fmt);
+    }
+
+    gpu->formats     = formats.elem;
+    gpu->num_formats = formats.num;
+}
