+    // Import VideoToolbox's CVPixelBuffer planes as Metal textures. Keep the
+    // mapper and decoder surface alive for this queued frame, until unmap.
+    struct ra_hwdec *hwdec = ra_hwdec_get(&p->hwdec_ctx, mpi->imgfmt);
+    if (hwdec) {
+        fp->mapper = ra_hwdec_mapper_create(hwdec, &mpi->params);
+        if (!fp->mapper || ra_hwdec_mapper_map(fp->mapper, mpi) < 0) {
+            ra_hwdec_mapper_free(&fp->mapper);
+            talloc_free(mpi);
+            return false;
+        }
+        struct mp_image_params par = fp->mapper->dst_params;
+        mp_image_params_guess_csp(&par);
+        frame->color = par.color;
+        frame->repr = par.repr;
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(par.imgfmt);
+        frame->num_planes = desc.num_planes;
+        for (int n = 0; n < frame->num_planes; n++) {
+            struct pl_plane *plane = &frame->planes[n];
+            plane->texture = (pl_tex)fp->mapper->tex[n]->priv;
+            int *map = plane->component_mapping;
+            for (int c = 0; c < mp_imgfmt_desc_get_num_comps(&desc); c++) {
+                if (desc.comps[c].plane != n)
+                    continue;
+                int index = plane->components++;
+                while (index > 0 &&
+                       desc.comps[map[index - 1]].offset > desc.comps[c].offset) {
+                    map[index] = map[index - 1];
+                    index--;
+                }
+                map[index] = c;
+            }
+        }
